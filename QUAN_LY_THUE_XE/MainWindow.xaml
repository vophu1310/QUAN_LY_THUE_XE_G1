<Window x:Class="QUAN_LY_THUE_XE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý thuê xe"
        Height="800" Width="1000" MinHeight="680" MinWidth="1024"
        WindowStartupLocation="CenterScreen" Background="#F3F6F4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#A9BEB4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#21483D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#28614F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#102D25">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="#1B5A46" VerticalAlignment="Center">
                            <TextBlock Text="R" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="Nhóm 1" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Quản lý thuê xe" Foreground="#8DA99D" FontSize="8" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    <Separator Background="#29473D" Margin="0,20,0,13"/>
                    <TextBlock Text="QUẢN LÝ CHUNG" Foreground="#718C81" FontSize="9" FontWeight="Bold" Margin="8,0,0,7"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="15,0,15,12">
                    <TextBlock Text="Hỗ trợ" Foreground="#82998E" FontSize="9" FontWeight="Bold" Margin="9,0,0,7"/>
                    <Button Content="⚙   Cài đặt" Style="{StaticResource NavigationButton}" IsEnabled="False"/>
                    <Button Content="ⓘ   Trung tâm trợ giúp" Style="{StaticResource NavigationButton}" IsEnabled="False"/>
                    <Separator Background="#29473D" Margin="8,12,8,0"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,0">
                        <Button x:Name="btnDashboard" Content="⊞   Tổng quan" Style="{StaticResource NavigationButton}" Click="BtnDashboard_Click"/>
                        <Button x:Name="btnBooking" Content="▣   Đặt lịch" Style="{StaticResource NavigationButton}" Click="BtnRental_Click"/>
                        <Button x:Name="btnVehicle" Content="▤   Phương tiện" Style="{StaticResource NavigationButton}" Click="BtnVehicle_Click"/>
                        <Button x:Name="btnCustomer" Content="♙   Khách hàng" Style="{StaticResource NavigationButton}" Click="BtnCustomer_Click"/>
                        <Button x:Name="btnRental" Content="▧   Hợp đồng" Style="{StaticResource NavigationButton}" Click="BtnRental_Click"/>
                        <Button x:Name="btnHandover" Content="⇄   Bàn giao xe" Style="{StaticResource NavigationButton}" Click="BtnHandover_Click"/>
                        <Button x:Name="btnReports" Content="▥   Báo cáo" Style="{StaticResource NavigationButton}" Click="BtnDashboard_Click"/>
                        <Button x:Name="btnFinance" Content="▣   Thanh toán" Style="{StaticResource NavigationButton}" Click="BtnFinance_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#F3F6F4">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E7ECE9" BorderThickness="0,0,0,1" Padding="25,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Trang chủ" Foreground="#8B9892" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="  /  " Foreground="#B5C0BA" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Quản lý thuê xe" Foreground="#263A32" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="●" Foreground="#2D7359" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Hệ thống hoạt động" Foreground="#6A7A72" FontSize="10" VerticalAlignment="Center" Margin="0,0,18,0"/>
                        <Border Width="30" Height="30" CornerRadius="15" Background="#E4EEE8">
                            <TextBlock Text="A" Foreground="#1E5945" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="MainContentArea" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>