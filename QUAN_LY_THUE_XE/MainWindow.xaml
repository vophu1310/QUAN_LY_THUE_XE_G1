<Window x:Class="QUAN_LY_THUE_XE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Hệ thống Quản lý Thuê xe - Nhóm 1"
        Height="820" Width="1350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A2B7AD"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D3D32"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#F8FAFC" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR XANH RÊU CHUẨN FIGMA -->
            <Border Grid.Column="0" Background="#132E24" Padding="18,24" MouseDown="Window_MouseDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28">
                        <TextBlock Text="Nhom 1" FontSize="21" FontWeight="Bold" Foreground="White" FontFamily="Bahnschrift"/>
                        <TextBlock Text="Quản lý thuê xe" FontSize="11" Foreground="#8FA39A" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                        <TextBlock Text="Hỗ trợ" FontSize="11" Foreground="#658176" Margin="12,0,0,8"/>
                        <Button Style="{StaticResource SidebarNavButtonStyle}" IsEnabled="False" Opacity="0.7">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Cài đặt" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SidebarNavButtonStyle}" IsEnabled="False" Opacity="0.7">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Trung tâm trợ giúp" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="QUẢN LÝ CHUNG" FontSize="10" FontWeight="SemiBold" Foreground="#658176" Margin="12,0,0,12"/>

                        <Button x:Name="btnDashboard" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnBooking" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnRental_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Đặt lịch" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnVehicle" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnVehicle_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CarMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Phương tiện" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnCustomer" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnCustomer_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroupOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Khách hàng" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnRental" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnRental_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Hợp đồng" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnReports" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Báo cáo" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnFinance" Style="{StaticResource SidebarNavButtonStyle}" Click="BtnFinance_Click">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Thanh toán" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- VÙNG NỘI DUNG BÊN PHẢI -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <ContentControl x:Name="MainContentArea"/>

                <Border Height="36" VerticalAlignment="Top" Background="Transparent" MouseDown="Window_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,12,0">
                        <Button Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click">
                            <materialDesign:PackIcon Kind="Minus" Foreground="#64748B" Width="16" Height="16"/>
                        </Button>
                        <Button Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMaximize_Click">
                            <materialDesign:PackIcon Kind="CropSquare" Foreground="#64748B" Width="16" Height="16"/>
                        </Button>
                        <Button Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                            <materialDesign:PackIcon Kind="Close" Foreground="#64748B" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>