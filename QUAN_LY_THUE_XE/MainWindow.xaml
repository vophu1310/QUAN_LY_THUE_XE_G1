<Window x:Class="QUAN_LY_THUE_XE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Thuê xe - GROUP 1" 
        Height="820" Width="1350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Khung viền ngoài bo tròn 16px bao trọn màn hình -->
    <Border CornerRadius="16" Background="#F8FAFC" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Sidebar xanh rêu chuẩn Figma (240px) -->
                <ColumnDefinition Width="240"/>
                <!-- Cột phải: Nội dung màn hình -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= CỘT BÊN TRÁI (SIDEBAR) ================= -->
            <Border Grid.Column="0" Background="#132E24" Padding="18,24" MouseDown="Window_MouseDown">
                <DockPanel LastChildFill="True">
                    <!-- 1. TOP: LOGO GROUP 1 -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,28">
                        <TextBlock Text="GROUP 1" FontSize="21" FontWeight="Bold" Foreground="White" FontFamily="Bahnschrift"/>
                        <TextBlock Text="Quản lý thuê xe" FontSize="11" Foreground="#8FA39A" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 2. BOTTOM: HỖ TRỢ & CÀI ĐẶT -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                        <TextBlock Text="Hỗ trợ" FontSize="11" Foreground="#658176" Margin="12,0,0,8"/>
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Cài đặt" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HelpCircleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Trung tâm trợ giúp" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 3. MIDDLE: DANH MỤC MENU CHÍNH -->
                    <StackPanel>
                        <TextBlock Text="QUẢN LÝ CHUNG" FontSize="10" FontWeight="SemiBold" Foreground="#658176" Margin="12,0,0,12"/>

                        <!-- Tổng quan -->
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng quan" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Đặt lịch (có Badge 12) -->
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand" Margin="0,0,0,4">
                            <DockPanel LastChildFill="False" Width="180">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đặt lịch" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#B88A44" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="12" FontSize="11" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </DockPanel>
                        </Button>

                        <!-- Phương tiện -->
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CarMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Phương tiện" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Khách hàng -->
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroupOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Khách hàng" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Hợp đồng (ĐANG CHỌN - Active Pill chuẩn Figma) -->
                        <Border Background="#24473B" CornerRadius="10" Margin="0,0,0,4">
                            <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="White" FontWeight="SemiBold" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hợp đồng" Margin="12,0,0,0" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Báo cáo -->
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Báo cáo" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- Thanh toán -->
                        <Button Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="12,10" Foreground="#A2B7AD" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Thanh toán" Margin="12,0,0,0" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= CỘT BÊN PHẢI (NỘI DUNG MÀN HÌNH) ================= -->
            <Grid Grid.Column="1" Background="#F8FAFC">
                <!-- Nơi nhúng màn hình con (RentalView) -->
                <ContentControl x:Name="MainContentArea" Margin="0"/>

                <!-- Thanh Header mỏng trên cùng: Cho phép nắm chuột kéo cửa sổ + 3 nút Điều khiển -->
                <Border Height="36" VerticalAlignment="Top" Background="Transparent" MouseDown="Window_MouseDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,12,0">
                        <!-- Nút Thu nhỏ (-) -->
                        <Button Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMinimize_Click">
                            <materialDesign:PackIcon Kind="Minus" Foreground="#64748B" Width="16" Height="16"/>
                        </Button>

                        <!-- Nút Phóng to / Thu lại (□) -->
                        <Button Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnMaximize_Click">
                            <materialDesign:PackIcon Kind="CropSquare" Foreground="#64748B" Width="16" Height="16"/>
                        </Button>

                        <!-- Nút Đóng (✕) -->
                        <Button Width="32" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click">
                            <materialDesign:PackIcon Kind="Close" Foreground="#64748B" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>