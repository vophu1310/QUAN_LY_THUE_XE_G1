<Window x:Class="QUAN_LY_THUE_XE.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng Nhập - Hệ Thống Quản Lý Thuê Xe" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        x:Name="LoginWin">

    <!-- Khung viền lớn bo góc 16px và viền sang trọng -->
    <Border CornerRadius="16" Background="#FAFAF9" ClipToBounds="True"
            BorderBrush="#E2E8F0" BorderThickness="1">

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Ảnh xe + Logo UIT -->
                <ColumnDefinition Width="*"/>
                <!-- Cột phải: Form đăng nhập -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== CỘT TRÁI (HERO BANNER) ==================== -->
            <Grid Grid.Column="0">
                <Image Source="https://images.unsplash.com/photo-1614162692292-7ac56d7f7f1e?auto=format&amp;fit=crop&amp;w=1000&amp;q=80"
                       Stretch="UniformToFill"/>

                <!-- Lớp phủ Gradient mờ -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#99000000" Offset="0.0"/>
                            <GradientStop Color="#11000000" Offset="0.3"/>
                            <GradientStop Color="#11000000" Offset="0.7"/>
                            <GradientStop Color="#CC000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Huy hiệu góc trên chứa LOGO -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="36,36,0,0"
                        Background="#35000000" BorderBrush="#45FFFFFF" BorderThickness="1" 
                        CornerRadius="20" Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CarSports" Width="18" Height="18" Foreground="#60A5FA" VerticalAlignment="Center"/>
                        <TextBlock Text="UNIVERSITY OF INFORMATION TECHNOLOGY" Foreground="White" FontWeight="Bold" 
                                   FontSize="10" Margin="8,0,4,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Chữ góc dưới: Nhóm 1 -->
                <TextBlock Text="Nhóm 1" VerticalAlignment="Bottom" Margin="40,0,0,40"
                           Foreground="White" FontSize="36" FontWeight="SemiBold" FontFamily="Georgia"/>
            </Grid>

            <!-- ==================== CỘT PHẢI (FORM ĐĂNG NHẬP) ==================== -->
            <Grid Grid.Column="1" Background="#FAF9F6">

                <!-- NÚT ĐÓNG (✕) Ở GÓC TRÊN BÊN PHẢI -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                        Background="Transparent" BorderThickness="0" 
                        Click="BtnClose_Click" Cursor="Hand" Padding="6">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                </Button>

                <StackPanel VerticalAlignment="Center" Margin="50,0">

                    <!-- Tiêu đề "Chào mừng trở lại" -->
                    <TextBlock Text="Chào mừng trở lại" 
                               FontSize="32" FontWeight="Bold" 
                               Foreground="#0F172A" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,28"/>

                    <!-- 1. TÊN ĐĂNG NHẬP -->
                    <TextBlock Text="Tên đăng nhập" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                    <Border BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Background="White" Height="48">
                        <Grid VerticalAlignment="Center" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                     BorderThickness="0" FontSize="14"
                                     Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Điền email hoặc tên đăng nhập"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden" TextChanged="TextBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <!-- BÁO LỖI TÊN ĐĂNG NHẬP (NẰM DƯỚI HỘP) -->
                    <TextBlock Text="{Binding LoiTenDangNhap}" Foreground="#EF4444" FontSize="12" 
                               FontWeight="Medium" Margin="4,4,0,8"/>

                    <!-- 2. MẬT KHẨU -->
                    <TextBlock Text="Mật khẩu" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                    <!-- Khung trắng CHỨA: Ổ khóa + Ô nhập + Con mắt -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Background="White" Height="48">
                        <Grid VerticalAlignment="Center" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon Ổ khóa -->
                            <materialDesign:PackIcon Kind="LockOutline" Width="20" Height="20" Foreground="#94A3B8" VerticalAlignment="Center"/>

                            <!-- Ô che dấu chấm tròn -->
                            <PasswordBox x:Name="PwdBox" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                         BorderThickness="0" FontSize="14"
                                         PasswordChanged="PwdBox_PasswordChanged"
                                         materialDesign:HintAssist.Hint="Điền mật khẩu"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                            <!-- Ô hiện chữ rõ khi bấm con mắt -->
                            <TextBox x:Name="TxtPasswordVisible" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                     BorderThickness="0" FontSize="14" Visibility="Collapsed"
                                     TextChanged="TxtPasswordVisible_TextChanged"
                                     materialDesign:HintAssist.Hint="Điền mật khẩu"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

                            <!-- Vùng bấm icon con mắt -->
                            <Border Grid.Column="2" Background="Transparent" Cursor="Hand" Padding="6"
                                    PreviewMouseDown="TogglePasswordVisibility_Click"> <!-- Đảo trạng thái thuộc tính Visibility-->
                                <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" 
                                                         Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- BÁO LỖI MẬT KHẨU (NẰM DƯỚI HỘP) -->
                    <TextBlock Text="{Binding LoiMatKhau}" Foreground="#EF4444" FontSize="12" 
                               FontWeight="Medium" Margin="4,4,0,12"/>

                    <!-- Dòng: Ghi nhớ & Quên mật khẩu -->
                    <Grid Margin="0,0,0,24">
                        <CheckBox Content="Ghi nhớ đăng nhập" 
                                  IsChecked="{Binding GhiNhoDangNhap}" 
                                  FontSize="13" Foreground="#64748B"/>
                        <TextBlock Text="Quên mật khẩu?" 
                                   HorizontalAlignment="Right" 
                                   FontSize="13" Foreground="#475569" 
                                   Cursor="Hand" FontWeight="Medium"/>
                    </Grid>

                    <!-- Dòng báo lỗi đỏ chung (nếu sai tài khoản/mật khẩu) -->
                    <TextBlock Text="{Binding ThongBaoLoi}" 
                               Foreground="#EF4444" FontSize="13" 
                               FontWeight="Medium" HorizontalAlignment="Center" 
                               Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <!-- Nút Đăng nhập xanh rêu -->
                    <Button Content="Đăng nhập  ➔" 
                            Background="#1E3E34" BorderBrush="#1E3E34" Foreground="White"
                            Height="48" FontSize="15" FontWeight="SemiBold"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Command="{Binding DangNhapCommand}"
                            CommandParameter="{Binding ElementName=LoginWin}"/>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>