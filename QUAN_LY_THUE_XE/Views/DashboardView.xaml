<UserControl x:Class="QUAN_LY_THUE_XE.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Background="#F1F5F9" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="10,20,10,30">
            <TextBlock Text="TỔNG QUAN HỆ THỐNG" FontSize="23" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Thống kê nhanh trạng thái đội xe" FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 3 card số liệu lớn -->
        <Grid Grid.Row="1" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Tổng số xe -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,10,0" Padding="30,28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🚗" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCarsText" Text="--"
                               FontSize="60" FontWeight="Bold"
                               Foreground="#1E293B"
                               HorizontalAlignment="Center" Margin="0,10,0,6"/>
                    <TextBlock Text="Tổng số xe" FontSize="15"
                               Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Đang được thuê -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Margin="5,0" Padding="30,28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔑" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RentingCarsText" Text="--"
                               FontSize="60" FontWeight="Bold"
                               Foreground="#F97316"
                               HorizontalAlignment="Center" Margin="0,10,0,6"/>
                    <TextBlock Text="Đang được thuê" FontSize="15"
                               Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Sẵn sàng -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Margin="10,0,0,0" Padding="30,28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✅" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AvailableCarsText" Text="--"
                               FontSize="60" FontWeight="Bold"
                               Foreground="#22C55E"
                               HorizontalAlignment="Center" Margin="0,10,0,6"/>
                    <TextBlock Text="Sẵn sàng cho thuê" FontSize="15"
                               Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Thời gian cập nhật / thông báo lỗi -->
        <TextBlock x:Name="DashboardStatus" Grid.Row="2"
                   Margin="10,20,10,0"
                   Foreground="#94A3B8" FontSize="12"/>
    </Grid>
</UserControl>