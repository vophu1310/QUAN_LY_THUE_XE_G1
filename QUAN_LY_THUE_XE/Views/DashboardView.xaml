<UserControl x:Class="QUAN_LY_THUE_XE.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F7F9F8"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,36,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HÀNG 0: THANH TÌM KIẾM & HỒ SƠ QUẢN TRỊ VIÊN -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E8EDE9" BorderThickness="1"
                    CornerRadius="12" Padding="16,10" Margin="0,0,0,20">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Ô tìm kiếm -->
                        <Border Background="#F3F5F4" CornerRadius="8" Padding="10,7" Width="230" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Tìm kiếm đơn đặt, phương tiện..." Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Chuông thông báo -->
                        <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20" Foreground="#475569"/>
                            <Ellipse Width="7" Height="7" Fill="#D97706" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>

                        <Border Width="1" Height="24" Background="#E2E8F0" Margin="0,0,14,0"/>

                        <!-- Tên quản trị viên -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Nguyen Van A" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Quản trị viên" FontSize="10.5" Foreground="#64748B"/>
                        </StackPanel>
                        <materialDesign:PackIcon Kind="ChevronDown" Width="16" Height="16" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- HÀNG 1: TIÊU ĐỀ & NÚT XUẤT BÁO CÁO -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <TextBlock Text="Tổng quan doanh thu" FontSize="25" FontWeight="Bold" Foreground="#132E24" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="15" Height="15" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="28/11/2026" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="15" Height="15" Foreground="#64748B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E5641" CornerRadius="8" Padding="15,9">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DownloadOutline" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Xuất báo cáo" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- HÀNG 2: 4 THẺ KPI -->
            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,18">
                <!-- Card 1 -->
                <Border Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Tổng doanh thu" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="$48,250" FontSize="27" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E6F4EC" CornerRadius="5" Padding="6,2" Margin="0,0,7,0">
                                    <TextBlock Text="+12.0%" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641"/>
                                </Border>
                                <TextBlock Text="So với kỳ trước" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="8" Background="#EEF5F0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="WalletOutline" Width="18" Height="18" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2 -->
                <Border Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Xe đang cho thuê" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="86" FontSize="27" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E6F4EC" CornerRadius="5" Padding="6,2" Margin="0,0,7,0">
                                    <TextBlock Text="+8.9%" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641"/>
                                </Border>
                                <TextBlock Text="So với kỳ trước" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="8" Background="#EEF5F0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="CalendarBlankOutline" Width="18" Height="18" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 3 -->
                <Border Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,12,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Xe đang trống" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="34" FontSize="27" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#E6F4EC" CornerRadius="5" Padding="6,2" Margin="0,0,7,0">
                                    <TextBlock Text="+6.3%" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641"/>
                                </Border>
                                <TextBlock Text="So với kỳ trước" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="8" Background="#EEF5F0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="CarOutline" Width="18" Height="18" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 4 -->
                <Border Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="18">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Đang chờ phê duyệt" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="12" FontSize="27" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FEF3E2" CornerRadius="5" Padding="6,2" Margin="0,0,7,0">
                                    <TextBlock Text="+9.1%" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                </Border>
                                <TextBlock Text="So với kỳ trước" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Width="34" Height="34" CornerRadius="8" Background="#EEF5F0" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- HÀNG 3: BIỂU ĐỒ DOANH THU & PHÂN LOẠI XE -->
            <Grid Grid.Row="3" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- BIỂU ĐỒ CỘT DOANH THU -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="20">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Biểu đồ doanh thu" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Doanh thu theo ngày - Tháng 11/2026" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Border Width="7" Height="7" CornerRadius="2" Background="#1E4D3B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Doanh thu" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <TextBlock Text="$48,250" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="+12.0%" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E5641" VerticalAlignment="Bottom" Margin="10,0,5,3"/>
                            <TextBlock Text="So với kỳ trước" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>

                        <TextBlock Text="USD" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,0,4,4"/>

                        <!-- Khung cột biểu đồ -->
                        <Grid Height="130">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Trục Y -->
                            <Grid Grid.Column="0">
                                <TextBlock Text="$5k" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Top"/>
                                <TextBlock Text="$2.5k" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock Text="$0" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Bottom"/>
                            </Grid>

                            <!-- Đường kẻ ngang & 16 cột -->
                            <Grid Grid.Column="1">
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" VerticalAlignment="Center"/>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                                <UniformGrid Rows="1" Columns="16" VerticalAlignment="Bottom" Height="124" Margin="4,0">
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="56" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="68" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="46" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="78" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="88" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="74" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="96" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="64" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="82" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="76" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="102" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="86" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="80" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="92" VerticalAlignment="Bottom"/>
                                    <Border Background="#B9CEBF" CornerRadius="4,4,0,0" Width="16" Height="98" VerticalAlignment="Bottom"/>
                                    <Border Background="#1E4D3B" CornerRadius="4,4,0,0" Width="16" Height="114" VerticalAlignment="Bottom"/>
                                </UniformGrid>
                            </Grid>
                        </Grid>

                        <!-- Trục X -->
                        <Grid Margin="36,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="01 Nov" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Grid.Column="1" Text="04 Nov" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="08 Nov" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="12 Nov" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="16 Nov" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- BIỂU ĐỒ DONUT PHÂN LOẠI XE -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Phân loại xe" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vòng Donut 4 phân khúc chuẩn tỷ lệ 40% / 30% / 20% / 10% -->
                            <Grid Grid.Column="0" Width="150" Height="150" Margin="0,0,18,0">
                                <Canvas Width="150" Height="150">
                                    <Path Stroke="#1E4D3B" StrokeThickness="18" Data="M 77,17 A 58,58 0 0 1 110.7,120.7"/>
                                    <Path Stroke="#7D9E87" StrokeThickness="18" Data="M 107.4,123.1 A 58,58 0 0 1 20.5,94.8"/>
                                    <Path Stroke="#C9A96E" StrokeThickness="18" Data="M 19.2,91 A 58,58 0 0 1 39.3,29.3"/>
                                    <Path Stroke="#D8DFD5" StrokeThickness="18" Data="M 42.6,26.9 A 58,58 0 0 1 73,17"/>
                                </Canvas>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="120" FontSize="24" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tổng số xe" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Chú thích phân loại -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#1E4D3B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="SUV" FontSize="12" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="48" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,14,0"/>
                                        <TextBlock Text="40%" FontSize="11.5" Foreground="#94A3B8" Width="30" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#7D9E87" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Sedan" FontSize="12" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="36" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,14,0"/>
                                        <TextBlock Text="30%" FontSize="11.5" Foreground="#94A3B8" Width="30" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#C9A96E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Xe thể thao" FontSize="12" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="24" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,14,0"/>
                                        <TextBlock Text="20%" FontSize="11.5" Foreground="#94A3B8" Width="30" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#D8DFD5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Xe điện" FontSize="12" Foreground="#334155"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="12" FontSize="12" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,14,0"/>
                                        <TextBlock Text="10%" FontSize="11.5" Foreground="#94A3B8" Width="30" TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- HÀNG 4: ĐƠN ĐẶT XE GẦN ĐÂY -->
            <Border Grid.Row="4" Background="White" BorderBrush="#E8EDE9" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Đơn đặt xe gần đây" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Xem tất cả đơn →" FontSize="12" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Header bảng -->
                    <Border Background="#F7F8F5" CornerRadius="6" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mã đơn" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Khách hàng" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Phương tiện" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Thời gian thuê" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="Tổng tiền" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="5" Text="Trạng thái" FontSize="11.5" Foreground="#64748B" FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- Dòng 1 -->
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#AR-2048" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="James Wilson" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Porsche 911 Carrera" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="16–19 Nov, 2026" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="$1,350" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Background="#E6F4EC" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="• Đang cho thuê" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641"/>
                            </Border>
                            <materialDesign:PackIcon Grid.Column="6" Kind="DotsHorizontal" Width="16" Height="16" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Dòng 2 -->
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#AR-2047" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Olivia Bennett" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Mercedes-Benz S-Class" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="16–18 Nov, 2026" FontSize="12.5" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="$780" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Grid.Column="5" Background="#EBF2FE" CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="• Đã duyệt" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                            </Border>
                            <materialDesign:PackIcon Grid.Column="6" Kind="DotsHorizontal" Width="16" Height="16" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Dòng 3 -->
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="32"/>
