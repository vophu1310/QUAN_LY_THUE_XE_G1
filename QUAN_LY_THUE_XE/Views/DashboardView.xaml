<UserControl x:Class="QUAN_LY_THUE_XE.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F3F6F4" Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Tổng quan doanh thu" FontSize="23" FontWeight="Bold" Foreground="#20362D"/>
                    <TextBlock Text="Theo dõi nhanh tình hình hoạt động của hệ thống" FontSize="12" Foreground="#839189" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="#E4EAE6" BorderThickness="1" CornerRadius="7" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◷" Foreground="#517261" Margin="0,0,8,0"/>
                        <TextBlock Text="Hôm nay" Foreground="#52645A" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                <Border Background="White" CornerRadius="9" Padding="17" Margin="0,0,9,0" BorderBrush="#E8EDE9" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỔNG SỐ XE" Foreground="#8A9790" FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="TotalCarsText" Text="--" Foreground="#20362D" FontSize="27" FontWeight="Bold" Margin="0,7,0,3"/>
                            <TextBlock Text="Đội xe trong hệ thống" Foreground="#95A098" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#EAF3EE" VerticalAlignment="Top">
                            <TextBlock Text="▣" Foreground="#27664F" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Background="White" CornerRadius="9" Padding="17" Margin="4,0" BorderBrush="#E8EDE9" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ĐANG CHO THUÊ" Foreground="#8A9790" FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="RentingCarsText" Text="--" Foreground="#B57B34" FontSize="27" FontWeight="Bold" Margin="0,7,0,3"/>
                            <TextBlock Text="Xe đang được sử dụng" Foreground="#95A098" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#FBF2E6" VerticalAlignment="Top">
                            <TextBlock Text="↗" Foreground="#B57B34" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Background="White" CornerRadius="9" Padding="17" Margin="9,0,0,0" BorderBrush="#E8EDE9" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SẴN SÀNG" Foreground="#8A9790" FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="AvailableCarsText" Text="--" Foreground="#27664F" FontSize="27" FontWeight="Bold" Margin="0,7,0,3"/>
                            <TextBlock Text="Có thể nhận đặt xe" Foreground="#95A098" FontSize="10"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="8" Background="#EAF3EE" VerticalAlignment="Top">
                            <TextBlock Text="✓" Foreground="#27664F" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" CornerRadius="9" Padding="18" Margin="0,0,9,0" BorderBrush="#E8EDE9" BorderThickness="1" MinHeight="230">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tình hình hoạt động" Foreground="#263A31" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Biểu đồ sẽ hiển thị khi có dữ liệu doanh thu được kết nối." Foreground="#89968F" FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,15,0,0" Background="#FBFCFB" CornerRadius="6" BorderBrush="#EEF1EF" BorderThickness="1">
                            <TextBlock Text="Chưa có dữ liệu biểu đồ" Foreground="#A0AAA4" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="9" Padding="18" Margin="9,0,0,0" BorderBrush="#E8EDE9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Tóm tắt đội xe" Foreground="#263A31" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Số liệu được truy vấn trực tiếp từ cơ sở dữ liệu." Foreground="#89968F" FontSize="10" Margin="0,5,0,14" TextWrapping="Wrap"/>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng số xe" Foreground="#68766E" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=TotalCarsText}" Foreground="#263A31" FontWeight="SemiBold" FontSize="11"/></Grid>
                        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Đang cho thuê" Foreground="#68766E" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=RentingCarsText}" Foreground="#263A31" FontWeight="SemiBold" FontSize="11"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sẵn sàng" Foreground="#68766E" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Text, ElementName=AvailableCarsText}" Foreground="#263A31" FontWeight="SemiBold" FontSize="11"/></Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="White" CornerRadius="9" Padding="18" BorderBrush="#E8EDE9" BorderThickness="1" MinHeight="110">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Đơn thuê gần đây" Foreground="#263A31" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Danh sách giao dịch sẽ xuất hiện tại đây khi được kết nối." Foreground="#89968F" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="DashboardStatus" Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,2,0" Foreground="#98A39D" FontSize="9"/>
        </Grid>
    </ScrollViewer>
</UserControl>