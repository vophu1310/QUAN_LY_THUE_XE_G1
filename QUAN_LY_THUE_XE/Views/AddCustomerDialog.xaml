<Window x:Class="QUAN_LY_THUE_XE.Views.AddCustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa khách hàng"
        Width="480" Height="610" MinHeight="500" MaxHeight="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- Style nhãn trường nhập -->
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Style hộp nhập liệu hiện đại bo tròn chuẩn Figma -->
        <Style x:Key="DialogInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tiêu đề -->
            <RowDefinition Height="*"/>    <!-- Form nhập dữ liệu -->
            <RowDefinition Height="Auto"/> <!-- Nút Hủy & Lưu -->
        </Grid.RowDefinitions>

        <!-- Tiêu đề Dialog -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock x:Name="txtTieuDe" Text="Chỉnh sửa khách hàng"
                       FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="txtMoTa" Text="Cập nhật thông tin khách hàng đã chọn"
                       FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form nhập thông tin khách hàng -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 1. Mã khách hàng (Chỉ đọc) -->
                <TextBlock Text="Mã khách hàng" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="tbMaKH" Style="{StaticResource DialogInputStyle}"
                         IsReadOnly="True" Background="#F1F5F9" Foreground="#94A3B8"
                         Margin="0,0,0,16"/>

                <!-- 2. Họ và tên * -->
                <TextBlock Text="Họ và tên *" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="tbHoTen" Style="{StaticResource DialogInputStyle}"
                         Margin="0,0,0,16"/>

                <!-- 3. Số điện thoại * -->
                <TextBlock Text="Số điện thoại *" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="tbSODT" Style="{StaticResource DialogInputStyle}"
                         Margin="0,0,0,16"/>

                <!-- 4. Căn cước công dân * -->
                <TextBlock Text="Căn cước công dân *" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="tbCCCD" Style="{StaticResource DialogInputStyle}"
                         Margin="0,0,0,16"/>

                <!-- 5. Giấy phép lái xe -->
                <TextBlock Text="Giấy phép lái xe" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox x:Name="tbGPLX" Style="{StaticResource DialogInputStyle}"
                         Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Hàng nút hành động -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nút Hủy -->
            <Button Grid.Column="1" Content="Hủy" Click="BtnHuy_Click"
                    Height="40" MinWidth="80" Padding="18,0" Margin="0,0,10,0"
                    FontSize="13" FontWeight="Medium" Cursor="Hand"
                    Background="White" Foreground="#475569"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>

            <!-- Nút Lưu thay đổi (màu xanh thương hiệu nhóm #14532D) -->
            <Button x:Name="btnLuu" Grid.Column="2" Content="✓ Lưu thay đổi" Click="BtnLuu_Click"
                    Height="40" Padding="20,0"
                    FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                    Background="#14532D" Foreground="White"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
