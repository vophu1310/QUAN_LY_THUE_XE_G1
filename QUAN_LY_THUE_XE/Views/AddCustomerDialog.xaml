<Window x:Class="QUAN_LY_THUE_XE.Views.AddCustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm khách hàng mới"
        Width="460" Height="620" MinHeight="520" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Tiêu đề -->
            <RowDefinition Height="*"/>
            <!-- Form nhập -->
            <RowDefinition Height="Auto"/>
            <!-- Nút hành động -->
        </Grid.RowDefinitions>

        <!-- Tiêu đề dialog -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Thêm khách hàng mới"
                       FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Nhập thông tin khách hàng để lưu vào hệ thống"
                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form cuộn được để tất cả trường nhập vẫn dùng được ở cửa sổ thấp. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <!-- Mã KH (readonly) -->
            <TextBlock Text="Mã khách hàng" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
            <TextBox x:Name="tbMaKH" Margin="0,4,0,14" Padding="10,8"
                     IsReadOnly="True" Background="#F1F5F9" Foreground="#94A3B8"
                     BorderBrush="#E2E8F0" BorderThickness="1" FontSize="13">
                <TextBox.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Họ tên -->
            <TextBlock Text="Họ và tên *" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
            <TextBox x:Name="tbHoTen" Margin="0,4,0,14" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" FontSize="13">
                <TextBox.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Số điện thoại -->
            <TextBlock Text="Số điện thoại *" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
            <TextBox x:Name="tbSODT" Margin="0,4,0,14" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" FontSize="13">
                <TextBox.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </TextBox.Resources>
            </TextBox>

            <!-- CCCD -->
            <TextBlock Text="Căn cước công dân *" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
            <TextBox x:Name="tbCCCD" Margin="0,4,0,14" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" FontSize="13">
                <TextBox.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </TextBox.Resources>
            </TextBox>

            <!-- GPLX -->
            <TextBlock Text="Giấy phép lái xe" Foreground="#475569" FontSize="13" FontWeight="SemiBold"/>
            <TextBox x:Name="tbGPLX" Margin="0,4,0,0" Padding="10,8"
                     BorderBrush="#CBD5E1" BorderThickness="1" FontSize="13">
                <TextBox.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </TextBox.Resources>
            </TextBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Nút hành động -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Nút Hủy -->
            <Button Grid.Column="1" Content="Hủy" Click="BtnHuy_Click"
                    Padding="20,10" Margin="0,0,10,0"
                    FontSize="13" Cursor="Hand"
                    Background="White" Foreground="#475569"
                    BorderBrush="#CBD5E1" BorderThickness="1">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>

            <!-- Nút Lưu (xanh lá đậm) -->
            <Button Grid.Column="2" Content="✓ Lưu khách hàng" Click="BtnLuu_Click"
                    Padding="20,10"
                    FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                    Background="#166534" Foreground="White"
                    BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>

