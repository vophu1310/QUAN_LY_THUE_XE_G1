<UserControl x:Class="QUAN_LY_THUE_XE.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FontFamily="Segoe UI">

    <!-- Chừa lề trên 36px để không cấn vào 3 nút điều khiển (Thu nhỏ / Phóng to / Đóng) của MainWindow -->
    <Grid Background="#F8FAFC">
        <Grid Margin="28,36,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Tiêu đề + 4 Badge thống kê -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Thanh tìm kiếm + Bộ lọc + Nút hành động -->
                <RowDefinition Height="*"/>    <!-- Row 2: Bảng danh sách khách hàng (DataGrid) -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Thanh phân trang & Trạng thái -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- ROW 0: TIÊU ĐỀ + 4 THẺ THỐNG KÊ (ĐỒNG BỘ DEMO BẠN HOÀNG)     -->
            <!-- ============================================================ -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tiêu đề bên trái -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Quản lý khách hàng" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Danh sách khách hàng và thông tin thuê xe" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 4 Thẻ thống kê bên phải -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 1. Tổng số khách -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0" MinWidth="75">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TongSoKhachHang}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Khách hàng" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Khách an toàn -->
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0" MinWidth="75">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SoKhachAnToan}" Foreground="#065F46" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="An toàn" Foreground="#047857" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Khách cảnh báo -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,0" MinWidth="75">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SoKhachCanhBao}" Foreground="#92400E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cảnh báo" Foreground="#B45309" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. [Ghi chú cho bạn Hoàng]: Thẻ Blacklist màu đỏ nâu đúng chuẩn video demo -->
                    <Border Background="#991B1B" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="75">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SoKhachBlacklist}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Blacklist" Foreground="#FCA5A5" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 1: THANH TÌM KIẾM + BỘ LỌC + NÚT CHỈNH SỬA & THÊM MỚI    -->
            <!-- ============================================================ -->
            <Border Grid.Row="1" Background="White" CornerRadius="10"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ô tìm kiếm -->
                    <Grid Grid.Column="0" Margin="0,0,12,0" Height="36">
                        <TextBox x:Name="tbSearch"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,0" FontSize="13" VerticalContentAlignment="Center"
                                 BorderBrush="#CBD5E1" BorderThickness="1" Height="36">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="7"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <!-- Placeholder -->
                        <TextBlock Text="🔍  Tìm kiếm theo SĐT hoặc CCCD..."
                                   Foreground="#94A3B8" Margin="14,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=tbSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=tbSearch}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Bộ lọc trạng thái -->
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding StatusFilterIndex, Mode=TwoWay}"
                              MinWidth="140" Height="36" Padding="12,0" Margin="0,0,8,0"
                              FontSize="12" Foreground="#334155" Background="White"
                              BorderBrush="#CBD5E1" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tất cả trạng thái"/>
                        <ComboBoxItem Content="An toàn"/>
                        <ComboBoxItem Content="Cảnh báo"/>
                        <ComboBoxItem Content="Blacklist"/>
                    </ComboBox>

                    <!-- Nút Làm mới -->
                    <Button Grid.Column="2" Content="↻ Làm mới"
                            Command="{Binding LoadCommand}"
                            Height="36" Padding="14,0" Margin="0,0,8,0"
                            FontSize="12" FontWeight="Medium" Cursor="Hand"
                            Background="#F8FAFC" Foreground="#334155"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- [Ghi chú cho bạn Hoàng]: Nút Chỉnh sửa khách hàng -->
                    <Button Grid.Column="3" Content="✎ Chỉnh sửa"
                            Command="{Binding EditCommand}"
                            Height="36" Padding="14,0" Margin="0,0,8,0"
                            FontSize="12" FontWeight="Medium" Cursor="Hand"
                            Background="#F8FAFC" Foreground="#334155"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Nút Thêm khách hàng -->
                    <Button Grid.Column="4" Content="＋ Thêm khách hàng"
                            Command="{Binding AddCommand}"
                            Height="36" Padding="16,0"
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Background="#132E24" Foreground="White"
                            BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 2: BẢNG DANH SÁCH KHÁCH HÀNG (DataGrid Card)             -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" Background="White" CornerRadius="12"
                    BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding DanhSachKhachHang}"
                          SelectedItem="{Binding SelectedCustomer}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          BorderThickness="0"
                          Background="White"
                          RowHeight="48"
                          ColumnHeaderHeight="42"
                          FontSize="12">

                    <!-- Style header cột -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Style dòng dữ liệu -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Style cell -->
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã KH" Width="100"
                                            Binding="{Binding MaKH, StringFormat='KH{0:D3}'}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Họ và tên" Width="1.5*"
                                            Binding="{Binding HoTen}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Số điện thoại" Width="1.2*"
                                            Binding="{Binding SODT}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CCCD" Width="1.3*"
                                            Binding="{Binding CCCD}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="GPLX" Width="1.1*"
                                            Binding="{Binding GPLX}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Trạng thái" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusPill" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1"
                                            CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#059669" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="StatusLabel" Text="An toàn" Foreground="#047857" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsBlacklisted}" Value="True">
                                            <Setter TargetName="StatusPill" Property="Background" Value="#FEF2F2"/>
                                            <Setter TargetName="StatusPill" Property="BorderBrush" Value="#FECACA"/>
                                            <Setter TargetName="StatusDot" Property="Fill" Value="#DC2626"/>
                                            <Setter TargetName="StatusLabel" Property="Text" Value="Blacklist"/>
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="#B91C1C"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ============================================================ -->
            <!-- ROW 3: PHÂN TRANG & THÔNG BÁO TRẠNG THÁI                     -->
            <!-- ============================================================ -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bên trái: Số lượng khách và trạng thái tải dữ liệu -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ThongTinTrang}" Foreground="#334155" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Bên phải: Các nút phân trang -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="◀ Trước"
                            Command="{Binding PreviousPageCommand}"
                            Height="32" Padding="12,0" Margin="0,0,6,0"
                            FontSize="12" Cursor="Hand"
                            Background="White" Foreground="#475569"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>

                    <Border Background="#132E24" CornerRadius="6"
                            MinWidth="32" Height="32" Margin="0,0,6,0">
                        <TextBlock Text="{Binding TrangHienTai}"
                                   Foreground="White" FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding TongSoTrang, StringFormat='/ {0}'}"
                               Foreground="#64748B" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Content="Sau ▶"
                            Command="{Binding NextPageCommand}"
                            Height="32" Padding="12,0"
                            FontSize="12" Cursor="Hand"
                            Background="White" Foreground="#475569"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
