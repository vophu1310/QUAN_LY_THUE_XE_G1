<UserControl x:Class="QUAN_LY_THUE_XE.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FontFamily="Segoe UI">

    <Grid Background="#F3F6F4" Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Tiêu đề + Badge -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Thanh tìm kiếm + nút -->
            <RowDefinition Height="*"/>
            <!-- Row 2: DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Phân trang -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- ROW 0: TIÊU ĐỀ + BADGE TỔNG SỐ KHÁCH HÀNG                  -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Quản lý khách hàng" FontSize="23" FontWeight="Bold" Foreground="#20362D"/>
                <TextBlock Text="Danh sách khách hàng và thông tin thuê xe" FontSize="12" Foreground="#839189" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1" Background="White" BorderBrush="#E7ECE9" BorderThickness="1" CornerRadius="7" Padding="12,7" Margin="5,0" MinWidth="65">
                <StackPanel><TextBlock Text="{Binding TongSoKhachHang}" Foreground="#20362D" FontSize="15" FontWeight="Bold"/><TextBlock Text="Khách hàng" Foreground="#75837B" FontSize="8"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#EAF3EE" CornerRadius="7" Padding="12,7" Margin="5,0" MinWidth="65">
                <StackPanel><TextBlock Text="{Binding SoKhachAnToan}" Foreground="#27664F" FontSize="15" FontWeight="Bold"/><TextBlock Text="An toàn" Foreground="#587967" FontSize="8"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#FBF1E3" CornerRadius="7" Padding="12,7" Margin="5,0,0,0" MinWidth="65">
                <StackPanel><TextBlock Text="{Binding SoKhachCanhBao}" Foreground="#AD7027" FontSize="15" FontWeight="Bold"/><TextBlock Text="Cảnh báo" Foreground="#977144" FontSize="8"/></StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- ROW 1: THANH TÌM KIẾM + NÚT BỘ LỌC + NÚT THÊM MỚI        -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ô tìm kiếm -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="13"
                             BorderBrush="#CBD5E1" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <!-- Placeholder (ẩn khi có text) -->
                    <TextBlock Text="🔍 Tìm kiếm theo SĐT hoặc CCCD..."
                               Foreground="#94A3B8" Margin="12,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Column="1" SelectedIndex="{Binding StatusFilterIndex, Mode=TwoWay}"
                          MinWidth="120" Padding="9,7" Margin="0,0,8,0"
                          FontSize="10" Foreground="#52645A" Background="White"
                          BorderBrush="#E1E7E3" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Tất cả trạng thái"/>
                    <ComboBoxItem Content="An toàn"/>
                    <ComboBoxItem Content="Cảnh báo"/>
                </ComboBox>

                <!-- Nút Làm mới -->
                <Button Grid.Column="2" Content="↻ Làm mới"
                        Command="{Binding LoadCommand}"
                        Padding="12,8" Margin="0,0,8,0"
                        FontSize="11" Cursor="Hand"
                        Background="#F7F9F7" Foreground="#52645A"
                        BorderBrush="#E1E7E3" BorderThickness="1">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Mở dialog nhập khách hàng và lưu qua ViewModel/Service hiện có. -->
                <Button Grid.Column="3" Content="＋  Thêm khách hàng"
                        Command="{Binding AddCommand}"
                        Padding="14,8"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Background="#1E604A" Foreground="White"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 2: BẢNG DANH SÁCH KHÁCH HÀNG (DataGrid full-width)      -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="0">
            <DataGrid ItemsSource="{Binding DanhSachKhachHang}"
                      SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF1EF"
                      BorderThickness="0"
                             Background="White"
                             RowHeight="44"
                             ColumnHeaderHeight="38"
                             FontSize="11"
                             VerticalContentAlignment="Center"
                             Margin="8">

                      <DataGrid.Resources>
                          <!-- Căn TextBlock trong các cột dữ liệu vào giữa chiều cao của từng hàng. -->
                          <Style x:Key="CustomerCellTextStyle" TargetType="TextBlock">
                              <Setter Property="VerticalAlignment" Value="Center"/>
                              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                          </Style>
                      </DataGrid.Resources>

                      <!-- Style header cột -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F0F5F2"/>
                        <Setter Property="Foreground" Value="#68766E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#E4EAE6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Style dòng dữ liệu -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#34483E"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Style cell -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Giữ các cột dữ liệu khách hàng hiện có, không hiển thị thông tin giả chưa lưu trong DB. -->
                    <DataGridTextColumn Header="Mã KH" Width="85"
                                        Binding="{Binding MaKH, StringFormat='KH{0:D3}'}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CustomerCellTextStyle}">
                                <Setter Property="Margin" Value="8,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Họ và tên" Width="1.5*"
                                        Binding="{Binding HoTen}"
                                        ElementStyle="{StaticResource CustomerCellTextStyle}"/>
                    <DataGridTextColumn Header="Số điện thoại" Width="*"
                                        Binding="{Binding SODT}"
                                        ElementStyle="{StaticResource CustomerCellTextStyle}"/>
                    <DataGridTextColumn Header="CCCD" Width="*"
                                        Binding="{Binding CCCD}"
                                        ElementStyle="{StaticResource CustomerCellTextStyle}"/>
                    <DataGridTextColumn Header="GPLX" Width="*"
                                        Binding="{Binding GPLX}"
                                        ElementStyle="{StaticResource CustomerCellTextStyle}"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusPill" Background="#EAF3EE" CornerRadius="10" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#2D7359" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="StatusLabel" Text="An toàn" Foreground="#27664F" FontSize="9" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBlacklisted}" Value="True">
                                        <Setter TargetName="StatusPill" Property="Background" Value="#FCE9E7"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#B95047"/>
                                        <Setter TargetName="StatusLabel" Property="Text" Value="Blacklist"/>
                                        <Setter TargetName="StatusLabel" Property="Foreground" Value="#A9433A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 3: PHÂN TRANG                                            -->
        <!-- ============================================================ -->
        <Border Grid.Row="3" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Thông tin trang: "Hiển thị 1–10 / 93 khách hàng" -->
                <TextBlock Grid.Column="0"
                           Text="{Binding ThongTinTrang}"
                           Foreground="#64748B" FontSize="13"
                           VerticalAlignment="Center"/>

                <!-- Nút chuyển trang -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Trước"
                            Command="{Binding PreviousPageCommand}"
                            Padding="10,6" Margin="0,0,6,0"
                            FontSize="12" Cursor="Hand"
                            Background="White" Foreground="#475569"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Số trang hiện tại -->
                    <Border Background="#166534" CornerRadius="6"
                            MinWidth="36" Height="32" Margin="0,0,6,0">
                        <TextBlock Text="{Binding TrangHienTai}"
                                   Foreground="White" FontSize="13" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding TongSoTrang, StringFormat='/ {0}'}"
                               Foreground="#64748B" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Content="Sau ▶"
                            Command="{Binding NextPageCommand}"
                            Padding="10,6"
                            FontSize="12" Cursor="Hand"
                            Background="White" Foreground="#475569"
                            BorderBrush="#CBD5E1" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- ROW 4: THANH TRẠNG THÁI                                      -->
        <!-- ============================================================ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                   Foreground="#64748B" FontSize="12"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>