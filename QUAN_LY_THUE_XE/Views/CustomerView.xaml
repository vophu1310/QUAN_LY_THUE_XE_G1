<UserControl x:Class="QUAN_LY_THUE_XE.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Loaded="CustomerView_Loaded">

    <Grid Background="#F1F5F9" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề bên trái và các thao tác chính ở góc trên bên phải. -->
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="20,20,0,0">
                <TextBlock Text="HỒ SƠ KHÁCH HÀNG" FontSize="23" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Quản lý thông tin cá nhân, GPLX và lịch sử thuê xe" FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Hồ sơ mới" Padding="12,8" Margin="0,20,10,0" Click="NewCustomer_Click"/>
                <Button Content="Lưu hồ sơ" Padding="12,8" Margin="0,20,10,0" Click="SaveCustomer_Click"/>
                <Button Content="Xóa hồ sơ" Padding="12,8" Margin="0,20,10,0" Click="DeleteCustomer_Click"/>
                <Button x:Name="BlacklistButton" Content="Đưa vào danh sách đen" Padding="12,8" Margin="0,20,20,0" Click="ToggleBlacklist_Click"/>
            </StackPanel>
        </Grid>

        <!-- Danh sách khách hàng chiếm 2/3 chiều ngang, thông tin và lịch sử chiếm 1/3. -->
        <Grid Grid.Row="1" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Danh sách khách hàng" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <!-- Placeholder nằm trên TextBox và được ẩn khi người dùng bắt đầu nhập. -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Padding="8" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Tìm theo SĐT hoặc CCCD" Margin="9,0,0,0"
                                   Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <CheckBox x:Name="BlacklistOnlyCheckBox" Grid.Row="2" Content="Chỉ xem danh sách đen"
                              Margin="0,0,0,10" VerticalAlignment="Center"
                              Checked="BlacklistOnlyCheckBox_Changed" Unchecked="BlacklistOnlyCheckBox_Changed"/>
                    <DataGrid x:Name="CustomerGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="CustomerGrid_SelectionChanged" CanUserAddRows="False"
                              ColumnWidth="*">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding MaKH}" Width="*"/>
                            <DataGridTextColumn Header="CCCD" Binding="{Binding CCCD}" Width="*"/>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTen}" Width="*"/>
                            <!-- Binding SODT trùng với thuộc tính SODT được ánh xạ từ cột SQL cùng tên. -->
                            <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SODT}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Thông tin khách hàng" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,10"/>
                            <TextBlock  Text="Mã khách hàng" Foreground="#475569"/>
                            <TextBox x:Name="tbMaKhachHang" Margin="0,3,0,8" Padding="6" IsReadOnly="True"/>
                            <TextBlock Text="Họ và tên" Foreground="#475569"/>
                            <TextBox x:Name="NameBox" Margin="0,3,0,8" Padding="6"/>
                            <TextBlock Text="Số điện thoại" Foreground="#475569"/>
                            <TextBox x:Name="PhoneBox" Margin="0,3,0,8" Padding="6"/>
                            <TextBlock Text="CCCD" Foreground="#475569"/>
                            <TextBox x:Name="IdentityBox" Margin="0,3,0,8" Padding="6"/>
                            <TextBlock Text="Số giấy phép lái xe (GPLX)" Foreground="#475569"/>
                            <TextBox x:Name="LicenseBox" Margin="0,3,0,0" Padding="6"/>
                        </StackPanel>
                    </Border>

                    <!-- Bảng lịch sử đặt sau hồ sơ; cuộn xuống để xem khi không đủ chiều cao. -->
                    <Border Background="White" CornerRadius="8" Padding="10" MinHeight="280">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="HistoryHeading" Text="Lịch sử thuê"
                                       FontSize="15" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8"/>
                            <DataGrid x:Name="RentalHistoryGrid" Grid.Row="1" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" MinHeight="230"
                                      ColumnWidth="*">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã đơn" Binding="{Binding MaDon}" Width="*"/>
                                    <DataGridTextColumn Header="Xe" Binding="{Binding Xe.TenXe}" Width="*"/>
                                    <DataGridTextColumn Header="Ngày thuê" Binding="{Binding NgayBatDauThue, StringFormat={}{0:dd/MM/yyyy}}" Width="*"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Thông báo thao tác/lỗi hiển thị ở cuối vùng nội dung. -->
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,10,0,0" Foreground="#475569" TextWrapping="Wrap"/>
    </Grid>
</UserControl>