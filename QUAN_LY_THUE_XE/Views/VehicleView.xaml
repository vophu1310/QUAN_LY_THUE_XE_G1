<UserControl x:Class="QUAN_LY_THUE_XE.Views.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:QUAN_LY_THUE_XE.Helpers"
             xmlns:views="clr-namespace:QUAN_LY_THUE_XE.Views"
             Background="#F8FAFC"
             FontFamily="Segoe UI"
             Loaded="VehicleView_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:CurrencyConverter x:Key="CurrencyConv"/>
        <views:SafeImageConverter x:Key="SafeImgConv"/>
        <views:StatusPillBackgroundConverter x:Key="StatusBgConv"/>
        <views:StatusPillForegroundConverter x:Key="StatusFgConv"/>
        <views:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>

        <!-- Nút chính xanh rêu chuẩn Figma -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E5641"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#132E24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút phụ viền trắng -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Chi tiết màu xanh nhạt trên thẻ xe -->
        <Style x:Key="SoftGreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EDF4F0"/>
            <Setter Property="Foreground" Value="#132E24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9E9E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Bảo dưỡng màu cam nhạt -->
        <Style x:Key="WarningSoftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="Foreground" Value="#C2410C"/>
            <Setter Property="BorderBrush" Value="#FED7AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFEDD5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Xóa mềm (Ngưng hoạt động) màu đỏ nhạt -->
        <Style x:Key="DangerSoftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút lọc dạng viên thuốc (Filter Pill) -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E5641"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút thẻ KPI bấm để lọc trạng thái -->
        <Style x:Key="KpiCardButtonStyle" TargetType="Button">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="106"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox bo góc sạch -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E5641"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= NỘI DUNG CHÍNH ================= -->
        <Grid Margin="32,34,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HÀNG 1: TIÊU ĐỀ & 3 THẺ KPI CHUẨN FIGMA -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Danh sách xe" FontSize="26" FontWeight="Bold"
                           Foreground="#132E24" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding ChonLocKpiCommand}" CommandParameter="Tất cả trạng thái"
                            Background="White" BorderBrush="#E2E8F0" Margin="0,0,10,0"
                            ToolTip="Hiển thị toàn bộ xe">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KpiCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrangThaiLocDangChon}" Value="Tất cả trạng thái">
                                        <Setter Property="BorderBrush" Value="#94A3B8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding TongSoXeText}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Xe tổng cộng" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ChonLocKpiCommand}" CommandParameter="Sẵn sàng"
                            Background="#EDF7F1" BorderBrush="#D1EBD9" Margin="0,0,10,0"
                            ToolTip="Bấm để lọc nhanh xe Sẵn sàng">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KpiCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrangThaiLocDangChon}" Value="Sẵn sàng">
                                        <Setter Property="BorderBrush" Value="#1E5641"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SoXeSanSangText}" FontSize="22" FontWeight="Bold" Foreground="#1E5641"/>
                            <TextBlock Text="Sẵn sàng" FontSize="11" Foreground="#2B6B4F" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ChonLocKpiCommand}" CommandParameter="Đang thuê"
                            Background="#FFF6EB" BorderBrush="#FDE4C8"
                            ToolTip="Bấm để lọc nhanh xe Đang thuê">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource KpiCardButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrangThaiLocDangChon}" Value="Đang thuê">
                                        <Setter Property="BorderBrush" Value="#C2410C"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding SoXeDangThueText}" FontSize="22" FontWeight="Bold" Foreground="#C2410C"/>
                            <TextBlock Text="Đang thuê" FontSize="11" Foreground="#C2410C" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- HÀNG 2: TÌM KIẾM, BỘ LỌC PHÂN KHÚC + TRẠNG THÁI & NÚT THÊM XE -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ô tìm kiếm theo biển số hoặc tên xe -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="10" Padding="10,0" Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="17" Height="17"
                                                 Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchTextBox"
                                 Text="{Binding TuKhoaTimKiem, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" FontSize="12.5"
                                 Foreground="#0F172A" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Tìm biển số, tên xe..."
                                   Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Bộ lọc Trạng thái xe (Sẵn sàng / Đang thuê / Đang bảo dưỡng / Ngưng hoạt động) -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DanhSachLocTrangThai}"
                          SelectedItem="{Binding TrangThaiLocDangChon}"
                          Width="148" Height="38" Margin="10,0,0,0"
                          FontSize="12" Foreground="#334155" Background="White"
                          BorderBrush="#E2E8F0" Padding="10,0"
                          VerticalContentAlignment="Center"/>

                <!-- Dãy nút lọc phân khúc (Tất cả / Sedan / SUV / 7 chỗ / Xe điện) -->
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                    <Button Content="Tất cả" Command="{Binding ChonBoLocCommand}" CommandParameter="Tất cả">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoLocDangChon}" Value="Tất cả">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#132E24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Sedan" Command="{Binding ChonBoLocCommand}" CommandParameter="Sedan">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoLocDangChon}" Value="Sedan">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#132E24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="SUV" Command="{Binding ChonBoLocCommand}" CommandParameter="SUV">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoLocDangChon}" Value="SUV">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#132E24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="7 chỗ" Command="{Binding ChonBoLocCommand}" CommandParameter="7 chỗ">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoLocDangChon}" Value="7 chỗ">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#132E24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Xe điện" Command="{Binding ChonBoLocCommand}" CommandParameter="Xe điện">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoLocDangChon}" Value="Xe điện">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#132E24"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>

                <!-- Nút Làm mới & Thêm xe -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding LamMoiCommand}"
                            ToolTip="Đồng bộ lại dữ liệu từ SQL Server" Height="38" Width="38" Padding="0" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Foreground="#475569"/>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding MoFormThemCommand}" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Thêm xe" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- HÀNG 3: THÔNG TIN HIỂN THỊ & PHÂN TRANG -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ThongTinHienThi}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Border Background="#EDF7F1" CornerRadius="6" Padding="10,4" Margin="12,0,0,0"
                            Visibility="{Binding ThongBaoHeThong, Converter={StaticResource StrNotEmptyToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14"
                                                     Foreground="#1E5641" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding ThongBaoHeThong}" FontSize="12" Foreground="#1E5641"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding TrangTruocCommand}" Padding="10,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Trước" Margin="2,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Border Background="#132E24" CornerRadius="8" MinWidth="30" Padding="10,5" Margin="0,0,6,0">
                        <TextBlock Text="{Binding TrangHienTai}" Foreground="White" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Button Style="{StaticResource OutlineButtonStyle}" Command="{Binding TrangSauCommand}" Padding="8,5">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="15" Height="15" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- HÀNG 4: LƯỚI THẺ XE 4 CỘT (CARD VIEW) -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding DanhSachXeHienThi}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="14" Margin="0,0,14,14">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" Color="#0F172A"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="134"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- ẢNH XE + NHÃN TRẠNG THÁI NỔI -->
                                        <Border Grid.Row="0" Background="#EEF2F0" CornerRadius="13,13,0,0" ClipToBounds="True">
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source, ElementName=CarPhoto}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Visibility, ElementName=CarPhoto}" Value="Collapsed">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <materialDesign:PackIcon Kind="CarSide" Width="46" Height="46"
                                                                             Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HangXe}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <Image x:Name="CarPhoto"
                                                       Source="{Binding HinhAnh, Converter={StaticResource SafeImgConv}, NotifyOnTargetUpdated=True}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       TargetUpdated="VehicleImage_TargetUpdated"
                                                       ImageFailed="VehicleImage_ImageFailed"/>

                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                                                        CornerRadius="12" Padding="9,4"
                                                        Background="{Binding TrangThai, Converter={StaticResource StatusBgConv}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0"
                                                                 Fill="{Binding TrangThai, Converter={StaticResource StatusFgConv}}"/>
                                                        <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding TrangThai, Converter={StaticResource StatusFgConv}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- THÔNG TIN XE & 2 NÚT CHI TIẾT / SỬA -->
                                        <StackPanel Grid.Row="1" Margin="13,11,13,13">
                                            <TextBlock FontSize="11" Foreground="#64748B">
                                                <Run Text="{Binding SoChoNgoi, Mode=OneWay}"/>
                                                <Run Text=" chỗ  /  "/>
                                                <Run Text="{Binding NamSanXuat, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Text="{Binding TenXe}" FontSize="14.5" FontWeight="Bold"
                                                       Foreground="#0F172A" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TenXe}" Margin="0,3,0,4"/>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding BienSo}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#475569"/>
                                                <TextBlock Grid.Column="1" Text="{Binding HangXe}" FontSize="11.5"
                                                           Foreground="#94A3B8"/>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                                <TextBlock Text="{Binding GiaThueNgay, Converter={StaticResource CurrencyConv}}"
                                                           FontSize="15.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text=" / ngày" FontSize="11.5" Foreground="#64748B"
                                                           VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="Chi tiết"
                                                        Style="{StaticResource SoftGreenButtonStyle}"
                                                        Command="{Binding DataContext.MoChiTietCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="2" Content="Sửa"
                                                        Style="{StaticResource OutlineButtonStyle}" Padding="14,7"
                                                        Command="{Binding DataContext.MoFormSuaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding KhongCoDuLieu, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="CarOff" Width="52" Height="52" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                    <TextBlock Text="Không có phương tiện nào khớp bộ lọc hiện tại"
                               FontSize="15" FontWeight="SemiBold" Foreground="#64748B" Margin="0,10,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Thử đổi từ khóa tìm kiếm, chọn 'Tất cả' hoặc bấm '+ Thêm xe'."
                               FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= POPUP 1: THÊM / SỬA XE ================= -->
        <Grid Background="#800F172A" Visibility="{Binding DangMoForm, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="560" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.2" Color="#0F172A"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding TieuDeForm}" FontSize="19" FontWeight="Bold" Foreground="#132E24"/>
                            <TextBlock Text="Nhập đầy đủ thông tin phương tiện để lưu vào SQL Server"
                                       FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding DongFormCommand}" Style="{StaticResource OutlineButtonStyle}"
                                Width="32" Height="32" Padding="0">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Biển số xe *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormBienSo, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Tên xe *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormTenXe, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Hãng xe *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding DanhSachHangXeGoiY}"
                                          Text="{Binding FormHangXe, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Height="36" FontSize="13" Padding="8,6"
                                          BorderBrush="#CBD5E1" Background="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Năm sản xuất *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormNamSanXuat, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Số chỗ ngồi *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding DanhSachSoChoGoiY}"
                                          Text="{Binding FormSoChoNgoi, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" Height="36" FontSize="13" Padding="8,6"
                                          BorderBrush="#CBD5E1" Background="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Giá thuê / ngày (VNĐ) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormGiaThueNgay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Tiền cọc mặc định (VNĐ)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormTienCocMacDinh, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Số Km hiện tại (ODO km)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FormSoKmHienTai, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Text="Trạng thái xe" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding DanhSachTrangThai}"
                                          SelectedItem="{Binding FormTrangThai}"
                                          Height="36" FontSize="13" Padding="8,6"
                                          BorderBrush="#CBD5E1" Background="White"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                                <TextBlock Text="Hình ảnh xe (dán link https:// hoặc chọn tệp từ máy)"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Height="46" Width="60" CornerRadius="8" Background="#EEF2F0"
                                            HorizontalAlignment="Left" ClipToBounds="True">
                                        <Grid>
                                            <materialDesign:PackIcon Kind="ImageOutline" Width="20" Height="20"
                                                                     Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source, ElementName=PreviewCarPhoto}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Visibility, ElementName=PreviewCarPhoto}" Value="Collapsed">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <Image x:Name="PreviewCarPhoto"
                                                   Source="{Binding FormHinhAnh, Converter={StaticResource SafeImgConv}, NotifyOnTargetUpdated=True}"
                                                   Stretch="UniformToFill"
                                                   TargetUpdated="VehicleImage_TargetUpdated"
                                                   ImageFailed="VehicleImage_ImageFailed"/>
                                        </Grid>
                                    </Border>

                                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding FormHinhAnh, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36" Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Chọn ảnh" Style="{StaticResource OutlineButtonStyle}"
                                                Command="{Binding ChonAnhCommand}" Height="36" Margin="0,0,6,0"/>
                                        <Button Style="{StaticResource OutlineButtonStyle}" ToolTip="Gỡ ảnh"
                                                Command="{Binding XoaAnhCommand}" Height="36" Width="36" Padding="0">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="#64748B"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding ThongBaoLoiForm, Converter={StaticResource StrNotEmptyToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                                     Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ThongBaoLoiForm}" FontSize="12" Foreground="#B91C1C" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Hàng nút đáy Popup Sửa/Thêm -->
                    <Grid Grid.Row="3" Margin="0,18,0,0">
                        <Button HorizontalAlignment="Left" Style="{StaticResource DangerSoftButtonStyle}"
                                Command="{Binding XoaMemXeCommand}"
                                Visibility="{Binding LaCheDoSua, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Ngưng hoạt động"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy" Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding DongFormCommand}" Padding="18,9" Margin="0,0,8,0"/>
                            <Button Content="Lưu thông tin" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LuuXeCommand}" Padding="20,9"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= POPUP 2: CHI TIẾT XE ================= -->
        <Grid Background="#800F172A" Visibility="{Binding DangMoChiTiet, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="16" Width="530"
                    HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.2" Color="#0F172A"/>
                </Border.Effect>

                <StackPanel>
                    <Grid Height="195" Background="#EEF2F0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=DetailCarPhoto}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=DetailCarPhoto}" Value="Collapsed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <materialDesign:PackIcon Kind="CarSide" Width="64" Height="64" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chưa có ảnh phương tiện" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Image x:Name="DetailCarPhoto"
                               Source="{Binding XeChiTiet.HinhAnh, Converter={StaticResource SafeImgConv}, NotifyOnTargetUpdated=True}"
                               Stretch="UniformToFill"
                               TargetUpdated="VehicleImage_TargetUpdated"
                               ImageFailed="VehicleImage_ImageFailed"/>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0"
                                CornerRadius="12" Padding="10,5"
                                Background="{Binding XeChiTiet.TrangThai, Converter={StaticResource StatusBgConv}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Fill="{Binding XeChiTiet.TrangThai, Converter={StaticResource StatusFgConv}}"/>
                                <TextBlock Text="{Binding XeChiTiet.TrangThai}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding XeChiTiet.TrangThai, Converter={StaticResource StatusFgConv}}"/>
                            </StackPanel>
                        </Border>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                                Command="{Binding DongChiTietCommand}" Style="{StaticResource OutlineButtonStyle}"
                                Width="32" Height="32" Padding="0">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#334155"/>
                        </Button>
                    </Grid>

                    <StackPanel Margin="24,18,24,22">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding XeChiTiet.TenXe}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0">
                                <Run Text="{Binding XeChiTiet.HangXe, Mode=OneWay}"/>
                                <Run Text="  •  Biển số: "/>
                                <Run Text="{Binding XeChiTiet.BienSo, Mode=OneWay}" FontWeight="SemiBold" Foreground="#132E24"/>
                            </TextBlock>
                        </StackPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,10">
                                    <TextBlock Text="Giá thuê theo ngày" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding XeChiTiet.GiaThueNgay, Converter={StaticResource CurrencyConv}}"
                                               FontSize="15" FontWeight="Bold" Foreground="#1E5641" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,10">
                                    <TextBlock Text="Tiền cọc mặc định" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding XeChiTiet.TienCocMacDinh, Converter={StaticResource CurrencyConv}}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Số chỗ / Năm sản xuất" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0">
                                        <Run Text="{Binding XeChiTiet.SoChoNgoi, Mode=OneWay}"/>
                                        <Run Text=" chỗ  •  "/>
                                        <Run Text="{Binding XeChiTiet.NamSanXuat, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="Số Km hiện tại (ODO)" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0">
                                        <Run Text="{Binding XeChiTiet.SoKmHienTai, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text=" km"/>
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- Hàng nút hành động: Bảo dưỡng, Xóa mềm (Ngưng hoạt động) & Chỉnh sửa -->
                        <Grid Margin="0,18,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Style="{StaticResource WarningSoftButtonStyle}"
                                        Command="{Binding ChuyenBaoDuongCommand}"
                                        CommandParameter="{Binding XeChiTiet}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="WrenchOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding NutBaoDuongText}"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource DangerSoftButtonStyle}"
                                        Command="{Binding XoaMemXeCommand}"
                                        CommandParameter="{Binding XeChiTiet}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cancel" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding NutXoaMemText}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding SuaTuChiTietCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Chỉnh sửa"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>