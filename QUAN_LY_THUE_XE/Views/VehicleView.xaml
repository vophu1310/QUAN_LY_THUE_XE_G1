<UserControl x:Class="QUAN_LY_THUE_XE.Views.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:views="clr-namespace:QUAN_LY_THUE_XE.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <views:SafeImageConverter x:Key="SafeImageConverter"/>
        <views:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <views:CategoryMatchConverter x:Key="CategoryMatchConverter"/>

        <!-- Style chip lọc phân khúc chuẩn Figma (không cắt chữ, tự xuống dòng nếu hẹp) -->
        <Style x:Key="FilterChipButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#34483E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#1E604A"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ChipBorder" Property="Background" Value="#132E24"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#132E24"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ComboBox bo góc trắng đồng bộ Figma -->
        <Style x:Key="FigmaComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#34483E"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE3DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#20362D"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="3,1">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#EAF3EE"/>
                                            <Setter Property="Foreground" Value="#132E24"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#DDECE4"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border"
                                                Background="White"
                                                BorderBrush="#DCE3DF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="ChevronDown"
                                                                         Width="16" Height="16"
                                                                         Foreground="#6C7C74"
                                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#1E604A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#1E604A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="11,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="White"
                                        BorderBrush="#DCE3DF"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="2,4"
                                        Margin="0,0,6,6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#132E24" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style nút bo góc dùng lại cho các thao tác trên thẻ xe -->
        <Style x:Key="CardPrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#EEF4F1"/>
            <Setter Property="Foreground" Value="#1E604A"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDEAE3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardOutlineBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#34483E"/>
            <Setter Property="BorderBrush" Value="#DCE3DF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F6F4"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E604A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardIconBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="31"/>
            <Setter Property="Height" Value="31"/>
            <Setter Property="Background" Value="#F8FAF9"/>
            <Setter Property="Foreground" Value="#52645A"/>
            <Setter Property="BorderBrush" Value="#E2E8E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF3EE"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1E604A"/>
                                <Setter Property="Foreground" Value="#1E604A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Chừa lề trên 34px để không đè vào cụm nút Thu nhỏ / Phóng to / Đóng của MainWindow -->
    <Grid Background="#F3F6F4">
        <Grid Margin="26,34,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Row 0: Tiêu đề + 3 thẻ thống kê Figma -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Tìm kiếm + Chip phân khúc + Nút Thêm xe -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Bộ lọc trạng thái + Làm mới + Phân trang -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Lưới thẻ xe (Card View) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 4: Thanh trạng thái -->
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- ROW 0: TIÊU ĐỀ & 3 THẺ THỐNG KÊ TỔNG QUAN (CHUẨN FIGMA)      -->
            <!-- ============================================================ -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Danh sách xe" FontSize="24" FontWeight="Bold" Foreground="#132E24"/>
                    <TextBlock Text="Quản lý đội xe, giá thuê, trạng thái vận hành và bảo dưỡng"
                               FontSize="12" Foreground="#7A8B82" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Thẻ 1: Xe tổng cộng -->
                <Border Grid.Column="1" Background="White" BorderBrush="#E5EBE7" BorderThickness="1"
                        CornerRadius="10" Padding="15,9" Margin="0,0,10,0" MinWidth="104">
                    <StackPanel>
                        <TextBlock Text="{Binding TongSoXe}" Foreground="#132E24" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Xe tổng cộng" Foreground="#75837B" FontSize="10.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ 2: Sẵn sàng -->
                <Border Grid.Column="2" Background="#EAF3EE" BorderBrush="#D6E8DE" BorderThickness="1"
                        CornerRadius="10" Padding="15,9" Margin="0,0,10,0" MinWidth="92">
                    <StackPanel>
                        <TextBlock Text="{Binding SoXeSanSang, StringFormat='{}{0:D2}'}"
                                   Foreground="#1E604A" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Sẵn sàng" Foreground="#4C7362" FontSize="10.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Thẻ 3: Đang thuê -->
                <Border Grid.Column="3" Background="#FBF1E3" BorderBrush="#F2DFC4" BorderThickness="1"
                        CornerRadius="10" Padding="15,9" MinWidth="92">
                    <StackPanel>
                        <TextBlock Text="{Binding SoXeDangThue, StringFormat='{}{0:D2}'}"
                                   Foreground="#AD7027" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Đang thuê" Foreground="#9A713F" FontSize="10.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 1: THANH TÌM KIẾM + CHIP PHÂN KHÚC (WRAP) + NÚT THÊM XE  -->
            <!-- ============================================================ -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ô tìm kiếm theo tên xe hoặc biển số -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E1E7E3" BorderThickness="1"
                        CornerRadius="9" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16"
                                                 Foreground="#8A9991" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12.5"
                                 Foreground="#1E293B" Padding="0,0,10,0"/>

                        <TextBlock Grid.Column="1" Text="Tìm bằng biển số, tên xe..."
                                   Foreground="#94A39B" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Nhóm chip phân khúc dùng WrapPanel: hiển thị đầy đủ, tự xuống dòng khi hẹp, không bao giờ đè chữ -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,8,0">
                    <Button Content="Tất cả" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,7,4"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="Tất cả"
                            Tag="{Binding SelectedCategory, Converter={StaticResource CategoryMatchConverter}, ConverterParameter='Tất cả'}"/>
                    <Button Content="4 chỗ" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,7,4"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="4 chỗ"
                            Tag="{Binding SelectedCategory, Converter={StaticResource CategoryMatchConverter}, ConverterParameter='4 chỗ'}"/>
                    <Button Content="5 chỗ" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,7,4"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="5 chỗ"
                            Tag="{Binding SelectedCategory, Converter={StaticResource CategoryMatchConverter}, ConverterParameter='5 chỗ'}"/>
                    <Button Content="7 chỗ" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,7,4"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="7 chỗ"
                            Tag="{Binding SelectedCategory, Converter={StaticResource CategoryMatchConverter}, ConverterParameter='7 chỗ'}"/>
                    <Button Content="SUV" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,7,4"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="SUV"
                            Tag="{Binding SelectedCategory, Converter={StaticResource CategoryMatchConverter}, ConverterParameter='SUV'}"/>
                    <Button Content="Xe điện" Style="{StaticResource FilterChipButtonStyle}" Margin="0,0,0,4"
                            Command="{Binding SelectCategoryCommand}" CommandParameter="Xe điện"
                            Tag="{Binding SelectedCategory, Converter={StaticResource CategoryMatchConverter}, ConverterParameter='Xe điện'}"/>
                </WrapPanel>

                <!-- Nút "+ Thêm xe" chuẩn Figma -->
                <Button Grid.Column="2" Command="{Binding AddCommand}"
                        Height="36" Padding="16,0" Background="#1E604A" Foreground="White"
                        FontSize="12.5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Top">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Thêm xe" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#164B39"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 2: LỌC TRẠNG THÁI + LÀM MỚI + THÔNG TIN & PHÂN TRANG     -->
            <!-- ============================================================ -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cụm lọc trạng thái + nút làm mới + số lượng hiển thị -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Trạng thái:" Foreground="#6C7C74" FontSize="12" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ComboBox SelectedIndex="{Binding StatusFilterIndex, Mode=TwoWay}"
                              Style="{StaticResource FigmaComboBoxStyle}"
                              Width="156" Margin="0,0,8,0">
                        <ComboBoxItem Content="Tất cả trạng thái"/>
                        <ComboBoxItem Content="Sẵn sàng"/>
                        <ComboBoxItem Content="Đang thuê"/>
                        <ComboBoxItem Content="Đang bảo dưỡng"/>
                        <ComboBoxItem Content="Ngưng hoạt động"/>
                    </ComboBox>

                    <Button Command="{Binding LoadCommand}"
                            Width="32" Height="32" Margin="0,0,14,0"
                            Background="White" BorderBrush="#DCE3DF" BorderThickness="1"
                            Foreground="#34483E" Cursor="Hand" ToolTip="Làm mới danh sách từ CSDL">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EAF3EE"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1E604A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding ThongTinTrang}"
                               Foreground="#6C7C74" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Cụm chuyển trang -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}" Height="30" Padding="10,0" Margin="0,0,6,0"
                            Background="White" Foreground="#475569" BorderBrush="#DCE3DF" BorderThickness="1"
                            FontSize="11.5" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="Trước" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1E604A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="#132E24" CornerRadius="7" MinWidth="30" Height="30" Padding="8,0" Margin="0,0,6,0">
                        <TextBlock Text="{Binding TrangHienTai}" Foreground="White" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding TongSoTrang, StringFormat='/ {0}'}"
                               Foreground="#6C7C74" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Command="{Binding NextPageCommand}" Height="30" Padding="10,0"
                            Background="White" Foreground="#475569" BorderBrush="#DCE3DF" BorderThickness="1"
                            FontSize="11.5" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Sau" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <materialDesign:PackIcon Kind="ChevronRight" Width="15" Height="15" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1E604A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 3: LƯỚI THẺ XE (CARD VIEW CHUẨN FIGMA)                   -->
            <!-- ============================================================ -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DanhSachXeHienThi}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="VehicleCard"
                                        Width="246"
                                        Margin="0,0,14,14"
                                        Background="White"
                                        BorderBrush="#E5EBE7"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#132E24" BlurRadius="12" ShadowDepth="2" Opacity="0.06"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="142"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Khu vực ảnh phương tiện + Status Pill nổi góc trái -->
                                        <Border Grid.Row="0" Background="#EAEFEE" CornerRadius="11,11,0,0" ClipToBounds="True">
                                            <Grid>
                                                <!-- Placeholder hiển thị khi chưa có ảnh hoặc ảnh lỗi -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55">
                                                    <materialDesign:PackIcon Kind="CarOutline" Width="46" Height="46"
                                                                             Foreground="#7A8F85" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding HangXe}" FontSize="11" Foreground="#7A8F85"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Ảnh thật (tải an toàn qua SafeImageConverter) -->
                                                <Image Source="{Binding HinhAnh, Converter={StaticResource SafeImageConverter}}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>

                                                <!-- Badge trạng thái góc trên trái -->
                                                <Border x:Name="StatusBadge"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="10,10,0,0" Padding="9,4" CornerRadius="11"
                                                        Background="#F4FAF6" BorderBrush="#D3E8DC" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#27664F"
                                                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock x:Name="StatusText" Text="{Binding TrangThai}"
                                                                   Foreground="#1E604A" FontSize="10.5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Nội dung thông số & nút thao tác -->
                                        <StackPanel Grid.Row="1" Margin="13,11,13,13">
                                            <!-- Dòng 1: Số chỗ / Năm SX + Hãng xe -->
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Foreground="#788780" FontSize="11" HorizontalAlignment="Left">
                                                    <Run Text="{Binding SoChoNgoi}"/>
                                                    <Run Text=" chỗ / "/>
                                                    <Run Text="{Binding NamSanXuat}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding HangXe}" Foreground="#788780" FontSize="11"
                                                           FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Dòng 2: Tên xe -->
                                            <TextBlock Text="{Binding TenXe}"
                                                       FontSize="14.5" FontWeight="Bold" Foreground="#132E24"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding TenXe}"
                                                       Margin="0,0,0,4"/>

                                            <!-- Dòng 3: Biển số + ODO km -->
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="{Binding BienSo}" Foreground="#3B4E44" FontSize="11.5"
                                                           FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding SoKmHienTai, StringFormat='{}{0:N0} km'}"
                                                           Foreground="#839189" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Dòng 4: Giá thuê/ngày -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding GiaThueNgay, StringFormat='{}{0:N0} đ'}"
                                                           FontSize="15.5" FontWeight="Bold" Foreground="#132E24"/>
                                                <TextBlock Text=" / ngày" FontSize="11" Foreground="#788780"
                                                           VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                            </StackPanel>

                                            <Border Height="1" Background="#EEF2F0" Margin="0,0,0,10"/>

                                            <!-- Dòng 5: Nút Chi tiết | Sửa | Bảo dưỡng | Xóa mềm -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="Chi tiết"
                                                        Style="{StaticResource CardPrimaryBtnStyle}"
                                                        Command="{Binding DataContext.DetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="1" Content="Sửa" Margin="6,0,0,0"
                                                        Style="{StaticResource CardOutlineBtnStyle}"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="2" Margin="6,0,0,0"
                                                        Style="{StaticResource CardIconBtnStyle}"
                                                        ToolTip="Chuyển đổi trạng thái Bảo dưỡng / Sẵn sàng"
                                                        Command="{Binding DataContext.ToggleMaintenanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="WrenchOutline" Width="15" Height="15"/>
                                                </Button>

                                                <Button Grid.Column="3" Margin="5,0,0,0"
                                                        Style="{StaticResource CardIconBtnStyle}"
                                                        ToolTip="Ngưng hoạt động (Xóa mềm) / Khôi phục xe"
                                                        Command="{Binding DataContext.SoftDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon x:Name="DeleteIcon" Kind="Power" Width="15" Height="15"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Triggers đổi màu trạng thái & hiệu ứng hover cho từng thẻ xe -->
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="VehicleCard" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="VehicleCard" Property="BorderBrush" Value="#B9D3C7"/>
                                    </Trigger>

                                    <!-- Đang thuê / Đang cho thuê -->
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đang thuê">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#FDF4E7"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#F3D9B5"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#AD7027"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đang cho thuê">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#FDF4E7"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#F3D9B5"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#D97706"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#AD7027"/>
                                    </DataTrigger>

                                    <!-- Đã đặt / Đang được đặt -->
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã đặt">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#EFF6FF"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#BFDBFE"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#2563EB"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đang được đặt">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#EFF6FF"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#BFDBFE"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#2563EB"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#1D4ED8"/>
                                    </DataTrigger>

                                    <!-- Đang bảo dưỡng -->
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đang bảo dưỡng">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#FEF2F2"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#FECACA"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#DC2626"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>

                                    <!-- Ngưng hoạt động -->
                                    <DataTrigger Binding="{Binding TrangThai}" Value="Ngưng hoạt động">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#CBD5E1"/>
                                        <Setter TargetName="StatusDot" Property="Fill" Value="#64748B"/>
                                        <Setter TargetName="StatusText" Property="Foreground" Value="#475569"/>
                                        <Setter TargetName="VehicleCard" Property="Opacity" Value="0.72"/>
                                        <Setter TargetName="DeleteIcon" Property="Kind" Value="Restore"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Trạng thái rỗng khi lọc không có xe -->
                <Border Background="White" CornerRadius="12" BorderBrush="#E5EBE7" BorderThickness="1"
                        Visibility="{Binding KhongCoDuLieu, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <materialDesign:PackIcon Kind="CarOutline" Width="54" Height="54"
                                                 Foreground="#A3B4AC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Không tìm thấy phương tiện phù hợp"
                                   FontSize="16" FontWeight="SemiBold" Foreground="#20362D"
                                   HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        <TextBlock Text="Thử đổi từ khóa tìm kiếm, chọn lại phân khúc hoặc thêm xe mới vào hệ thống."
                                   FontSize="12" Foreground="#7A8B82" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <Button Content="Đặt lại bộ lọc" Command="{Binding ResetFilterCommand}"
                                Style="{StaticResource CardPrimaryBtnStyle}" Padding="16,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ -->
            <!-- ROW 4: THANH TRẠNG THÁI                                      -->
            <!-- ============================================================ -->
            <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                       Foreground="#6C7C74" FontSize="11.5" Margin="2,8,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
