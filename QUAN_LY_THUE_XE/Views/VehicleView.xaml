<UserControl x:Class="QUAN_LY_THUE_XE.Views.VehicleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F3F6F4" Margin="26,22,26,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Danh sách xe" FontSize="23" FontWeight="Bold" Foreground="#20362D"/>
                    <TextBlock Text="Quản lý danh mục và tình trạng đội xe" FontSize="12" Foreground="#839189" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E9F1EC" CornerRadius="6" Padding="10,7" VerticalAlignment="Center">
                    <TextBlock Text="Dữ liệu xe từ hệ thống" Foreground="#47715D" FontSize="10"/>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,14" BorderBrush="#E8EDE9" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="#F8FAF8" BorderBrush="#E4EAE6" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌕" Foreground="#829189" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Tìm xe theo tên hoặc biển số" Foreground="#9AA59F" FontSize="11" VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" BorderBrush="#E4EAE6" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <TextBlock Text="Tất cả trạng thái  ▾" Foreground="#607067" FontSize="10"/>
                    </Border>
                    <Button Grid.Column="2" Content="＋  Thêm xe" IsEnabled="False" ToolTip="Chức năng thêm xe chưa được kết nối" Padding="14,8" Background="#1E604A" Foreground="White" BorderThickness="0" FontSize="10" FontWeight="SemiBold"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="18" BorderBrush="#E8EDE9" BorderThickness="1" MinHeight="330">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Danh mục phương tiện" Foreground="#263A31" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Chưa có dữ liệu tải lên" Foreground="#9AA59F" FontSize="10"/>
                    </Grid>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1EF" BorderBrush="#E8EDE9" RowHeight="42" ColumnHeaderHeight="38" FontSize="11">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F7F9F7"/><Setter Property="Foreground" Value="#68766E"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E8EDE9"/></Style></DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã xe" Width="*"/>
                            <DataGridTextColumn Header="Tên xe" Width="2*"/>
                            <DataGridTextColumn Header="Biển số" Width="*"/>
                            <DataGridTextColumn Header="Số chỗ" Width="*"/>
                            <DataGridTextColumn Header="Giá thuê/ngày" Width="*"/>
                            <DataGridTextColumn Header="Trạng thái" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>