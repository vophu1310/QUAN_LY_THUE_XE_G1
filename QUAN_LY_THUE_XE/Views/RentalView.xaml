<UserControl x:Class="QUAN_LY_THUE_XE.Views.RentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,36,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Hợp đồng thuê xe" FontSize="26" FontWeight="Bold"
                       Foreground="#132E24" Margin="0,0,0,22"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4.4*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="5.6*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: 01 KHÁCH HÀNG & 02 PHƯƠNG TIỆN -->
                <StackPanel Grid.Column="0">
                    <!-- 01 KHÁCH HÀNG -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="01" FontSize="12" FontWeight="Bold" Foreground="#1E5641" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Khách hàng" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <TextBlock Text="+ New customer" FontSize="12" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="9" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="Phạm Nhật Vượng" FontSize="13" FontWeight="Medium" Foreground="#0F172A"/>
                                    <materialDesign:PackIcon Kind="ChevronUp" Width="16" Height="16" Foreground="#1E5641" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>

                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
                                <StackPanel>
                                    <Border Background="#F8FAFC" CornerRadius="7" Padding="10,7" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Tìm bằng SĐT hoặc CCCD" FontSize="12" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#EDF7F1" CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Phạm Nhật Vượng" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="phamnhatvuong@gmail.com" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,3"/>
                                                <TextBlock Text="Thành viên · 4 lần thuê" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641"/>
                                            </StackPanel>
                                            <materialDesign:PackIcon Kind="Check" Width="16" Height="16" Foreground="#1E5641" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 02 PHƯƠNG TIỆN -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="02" FontSize="12" FontWeight="Bold" Foreground="#1E5641" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Phương tiện" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>
                                <TextBlock Text="Đổi phương tiện" FontSize="12" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="175" CornerRadius="12" Background="#E6E9E7" Margin="0,0,0,14" ClipToBounds="True">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CarSide" Width="66" Height="66" Foreground="#7A8B82" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Toyota RAV4 · 2025" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Background="White" CornerRadius="12" Padding="11,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                        <TextBlock Text="Sẵn sàng" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E5641"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Toyota RAV4" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ABC – 2841" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="2025 · Comfort SUV" FontSize="12" Foreground="#64748B" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="Automatic" FontSize="11" Foreground="#475569"/>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <TextBlock Text="5 chỗ" FontSize="11" Foreground="#475569"/>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,4">
                                    <TextBlock Text="Hybrid" FontSize="11" Foreground="#475569"/>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="1,500,000 đ" FontSize="19" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" / ngày" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- CỘT PHẢI: 03 NGÀY THUÊ, 04 TIỀN CỌC & HÓA ĐƠN -->
                <StackPanel Grid.Column="2">
                    <!-- 03 NGÀY THUÊ -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="03" FontSize="12" FontWeight="Bold" Foreground="#1E5641" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Ngày thuê" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="White" BorderBrush="#1E5641" BorderThickness="1.2" CornerRadius="10" Padding="12,9">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Ngày nhận" FontSize="10.5" Foreground="#64748B"/>
                                            <TextBlock Text="Wed, Nov 18, 2026" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="10:00 AM" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,9">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Ngày trả" FontSize="10.5" Foreground="#64748B"/>
                                            <TextBlock Text="Mon, Nov 23, 2026" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="10:00 AM" FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Lịch tháng & Khung tổng thời gian thuê -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lịch tháng November 2026 -->
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="4,0,4,10">
                                        <TextBlock Text="November 2026" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#64748B" Margin="0,0,10,0"/>
                                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Columns="7" Margin="0,0,0,6">
                                        <TextBlock Text="Mo" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tu" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="We" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Th" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Fr" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Sa" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Su" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    </UniformGrid>

                                    <UniformGrid Columns="7" Rows="6">
                                        <TextBlock Text="26" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="27" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="28" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="29" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="30" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="31" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="1" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>

                                        <TextBlock Text="2" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="3" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="4" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="5" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="6" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="7" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="8" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>

                                        <TextBlock Text="9" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="10" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="11" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="12" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="13" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="14" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="15" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>

                                        <TextBlock Text="16" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="17" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <Border Background="#1E5641" CornerRadius="5" Margin="2,2">
                                            <TextBlock Text="18" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#E6F4EC" Margin="0,2">
                                            <TextBlock Text="19" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#E6F4EC" Margin="0,2">
                                            <TextBlock Text="20" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#E6F4EC" Margin="0,2">
                                            <TextBlock Text="21" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#E6F4EC" Margin="0,2">
                                            <TextBlock Text="22" FontSize="11" FontWeight="SemiBold" Foreground="#1E5641" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Background="#1E5641" CornerRadius="5" Margin="2,2">
                                            <TextBlock Text="23" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="24" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="25" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="26" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="27" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="28" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="29" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>

                                        <TextBlock Text="30" FontSize="11" Foreground="#334155" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="1" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="2" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="3" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="4" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="5" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="6" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,5"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Khung 5 ngày bên phải lịch -->
                                <Border Grid.Column="2" Background="#F1F6F3" CornerRadius="10" Padding="14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#1E5641" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Text="Thời gian thuê" FontSize="11.5" Foreground="#475569"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock Text="5" FontSize="32" FontWeight="Bold" Foreground="#1E5641"/>
                                            <TextBlock Text=" ngày" FontSize="15" FontWeight="SemiBold" Foreground="#1E5641" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                                        </StackPanel>

                                        <Border Height="1" Background="#DCE6DF" Margin="0,0,0,10"/>

                                        <TextBlock Text="Ngày nhận" FontSize="10.5" Foreground="#64748B"/>
                                        <TextBlock Text="Wed, Nov 18, 2026" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,8"/>

                                        <TextBlock Text="Ngày trả" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right"/>
                                        <TextBlock Text="Mon, Nov 23, 2026" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 04 TIỀN ĐẶT CỌC -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,18">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="04" FontSize="12" FontWeight="Bold" Foreground="#1E5641" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Tiền đặt cọc" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18,7" Margin="0,0,8,0">
                                    <TextBlock Text="450,000 đ" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </Border>
                                <Border Background="#EDF7F1" CornerRadius="8" Padding="12,7">
                                    <TextBlock Text="30%" FontSize="13" FontWeight="Bold" Foreground="#1E5641"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- HÓA ĐƠN -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Hóa đơn" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Tiền thuê" FontSize="12.5" Foreground="#64748B"/>
                                <TextBlock Text="5 × 1 500 000" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock Text="7,500,000đ" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Thuế" FontSize="12.5" Foreground="#64748B"/>
                                <TextBlock Text="10%" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                <TextBlock Text="750,000đ" FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Tổng cộng" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="8,250,000đ" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                            </Grid>

                            <Border Background="#F1F6F3" CornerRadius="8" Padding="14,9">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tiền đặt cọc" FontSize="12" Foreground="#64748B" Margin="0,0,14,0"/>
                                        <TextBlock Text="450,000đ" FontSize="12" FontWeight="Bold" Foreground="#1E5641"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Còn lại" FontSize="12" Foreground="#64748B" Margin="0,0,18,0"/>
                                        <TextBlock Text="7,800,000đ" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- HÀNG NÚT ĐÁY -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="24,12">
                            <TextBlock Text="Lưu bản nháp" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                        </Border>

                        <Border Grid.Column="2" Background="#1E5641" CornerRadius="10" Padding="20,12">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="17" Height="17" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Tạo hợp đồng" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ArrowRight" Width="17" Height="17" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>