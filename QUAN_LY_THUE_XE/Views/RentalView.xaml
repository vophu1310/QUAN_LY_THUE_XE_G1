<UserControl x:Class="QUAN_LY_THUE_XE.Views.RentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F3F6F4" Margin="26,22,26,22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Hợp đồng thuê xe" FontSize="23" FontWeight="Bold" Foreground="#20362D"/><TextBlock Text="Tạo và quản lý thông tin thuê xe" FontSize="12" Foreground="#839189" Margin="0,5,0,0"/></StackPanel>
                <Border Grid.Column="1" Background="White" BorderBrush="#E4EAE6" BorderThickness="1" CornerRadius="6" Padding="11,7" VerticalAlignment="Center"><TextBlock Text="Quy trình thuê xe" Foreground="#607067" FontSize="10"/></Border>
            </Grid>
            <Border Grid.Row="1" Background="White" CornerRadius="9" Padding="14" Margin="0,0,0,14" BorderBrush="#E8EDE9" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="01  KHÁCH HÀNG" Foreground="#27664F" FontSize="9" FontWeight="Bold"/><TextBlock Text="Chọn hồ sơ khách thuê" Foreground="#8C9992" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="02  XE THUÊ" Foreground="#87948D" FontSize="9" FontWeight="Bold"/><TextBlock Text="Chọn xe khả dụng" Foreground="#A0AAA4" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="03  THỜI GIAN" Foreground="#87948D" FontSize="9" FontWeight="Bold"/><TextBlock Text="Thiết lập lịch thuê" Foreground="#A0AAA4" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="04  XÁC NHẬN" Foreground="#87948D" FontSize="9" FontWeight="Bold"/><TextBlock Text="Kiểm tra và hoàn tất" Foreground="#A0AAA4" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Border Background="White" CornerRadius="9" Padding="17" Margin="0,0,0,12" BorderBrush="#E8EDE9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Thông tin khách hàng" Foreground="#263A31" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Khách thuê" Foreground="#6D7A72" FontSize="10"/>
                            <TextBox IsEnabled="False" Text="Chọn khách hàng từ danh sách" Margin="0,5,0,10" Padding="9" Background="#FAFBFA" BorderBrush="#E1E7E3"/>
                            <TextBlock Text="Thông tin liên hệ" Foreground="#6D7A72" FontSize="10"/>
                            <Border Background="#F7F9F7" CornerRadius="6" Padding="10" Margin="0,5,0,0"><TextBlock Text="Thông tin sẽ hiển thị sau khi chọn khách hàng." Foreground="#98A39D" FontSize="10" TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="9" Padding="17" BorderBrush="#E8EDE9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Thời gian thuê" Foreground="#263A31" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Ngày nhận xe" Foreground="#6D7A72" FontSize="10"/><DatePicker IsEnabled="False" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Ngày trả dự kiến" Foreground="#6D7A72" FontSize="10"/><DatePicker IsEnabled="False" Margin="0,5,0,0"/></StackPanel></Grid>
                            <TextBlock Text="Thời lượng và giá thuê sẽ được tính sau khi chọn xe và ngày." Foreground="#98A39D" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Border Background="White" CornerRadius="9" Padding="17" Margin="0,0,0,12" BorderBrush="#E8EDE9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Chọn phương tiện" Foreground="#263A31" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBox IsEnabled="False" Text="Tìm theo tên xe hoặc biển số" Padding="9" Background="#FAFBFA" BorderBrush="#E1E7E3"/>
                            <Border Background="#F7F9F7" CornerRadius="6" Padding="10" Margin="0,10,0,0" MinHeight="83"><TextBlock Text="Danh sách xe sẵn sàng sẽ hiển thị tại đây." Foreground="#98A39D" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="9" Padding="17" BorderBrush="#E8EDE9" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tóm tắt hợp đồng" Foreground="#263A31" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tiền thuê dự kiến" Foreground="#6D7A72" FontSize="10"/><TextBlock Grid.Column="1" Text="—" Foreground="#263A31" FontSize="10"/></Grid>
                            <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tiền cọc" Foreground="#6D7A72" FontSize="10"/><TextBlock Grid.Column="1" Text="—" Foreground="#263A31" FontSize="10"/></Grid>
                            <Separator Background="#E8EDE9" Margin="0,4,0,10"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tổng cộng" Foreground="#263A31" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="—" Foreground="#1E604A" FontSize="14" FontWeight="Bold"/></Grid>
                            <Button Content="Tạo hợp đồng thuê" IsEnabled="False" ToolTip="Chức năng tạo hợp đồng chưa được kết nối" Background="#1E604A" Foreground="White" BorderThickness="0" Padding="12,9" Margin="0,14,0,0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>