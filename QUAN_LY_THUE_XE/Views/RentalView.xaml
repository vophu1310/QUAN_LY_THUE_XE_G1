<UserControl x:Class="QUAN_LY_THUE_XE.Views.RentalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100"
             Background="#F8FAFC">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <!-- Hàng 0: Header & Thanh chuyển Tab -->
            <RowDefinition Height="Auto"/>
            <!-- Hàng 1: Nội dung Tab -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== HÀNG 0: TIÊU ĐỀ & CHUYỂN TAB ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="28" Height="28" Foreground="#132E24" VerticalAlignment="Center"/>
                <TextBlock Text="Quản lý hợp đồng" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Cụm nút chuyển đổi 2 Tab (Lập HĐ / Danh sách) -->
            <Border HorizontalAlignment="Right" Background="#E2E8F0" CornerRadius="8" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <!-- Nút Tab 0: Lập hợp đồng mới -->
                    <Button Command="{Binding ChonTabCommand}" CommandParameter="0"
                            Height="32" Padding="14,0" BorderThickness="0" Cursor="Hand"
                            materialDesign:ButtonAssist.CornerRadius="6">
                    <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabDangChon}" Value="0">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Lập hợp đồng mới" Margin="6,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Tab 1: Danh sách hợp đồng -->
                    <Button Command="{Binding ChonTabCommand}" CommandParameter="1"
                            Height="32" Padding="14,0" BorderThickness="0" Cursor="Hand"
                            materialDesign:ButtonAssist.CornerRadius="6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TabDangChon}" Value="1">
                                        <Setter Property="Background" Value="#132E24"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Danh sách hợp đồng" Margin="6,0,0,0" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== HÀNG 1: NỘI DUNG 2 TAB ==================== -->
        <Grid Grid.Row="1">

            <!-- ================= TAB 0: LẬP HỢP ĐỒNG MỚI (4 KHỐI CHUẨN FIGMA) ================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabDangChon}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Cột Trái: 01 Khách hàng & 02 Phương tiện -->
                        <ColumnDefinition Width="4.8*"/>
                        <ColumnDefinition Width="24"/>
                        <!-- Cột Phải: 03 Ngày thuê, 04 Tiền cọc & Hóa đơn -->
                        <ColumnDefinition Width="6.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CỘT TRÁI -->
                    <StackPanel Grid.Column="0">
                        <!-- KHỐI 01: KHÁCH HÀNG -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="01  Khách hàng" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <TextBlock Text="+ New customer" HorizontalAlignment="Right" Foreground="#059669" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                                </Grid>

                                <ComboBox ItemsSource="{Binding DanhSachKhachHang}"
                                          SelectedItem="{Binding KhachHangDuocChon}"
                                          Height="44" Padding="12,0" Background="#F8FAFC" BorderBrush="#E2E8F0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountCircleOutline" Width="20" Height="20" Foreground="#059669" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding HoTen}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text=" • SĐT: " Foreground="#94A3B8" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SDT}" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding KhachHangDuocChon.HoTen, FallbackValue='Phạm Nhật Vượng'}" FontWeight="Bold" FontSize="14" Foreground="#065F46"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding KhachHangDuocChon.SDT, FallbackValue='0901234567'}" FontSize="12" Foreground="#047857"/>
                                                <TextBlock Text=" • Thành viên thân thiết" FontSize="12" Foreground="#047857"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Foreground="#059669" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- KHỐI 02: PHƯƠNG TIỆN -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="02  Phương tiện" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <TextBlock Text="Đổi phương tiện" HorizontalAlignment="Right" Foreground="#059669" FontWeight="SemiBold" FontSize="12" Cursor="Hand"/>
                                </Grid>

                                <Border CornerRadius="10" ClipToBounds="True" Height="190" Background="#F1F5F9" Margin="0,0,0,14">
                                    <Grid>
                                        <Image Source="https://i.postimg.cc/QdT44Lxc/2022-mazda-cx-5-2p5-turbo-signature-123-1657559083.avif" 
                                               Stretch="UniformToFill"/>
                                        <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4" 
                                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                                            <TextBlock Text="Sẵn sàng" Foreground="#15803D" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{Binding XeDuocChon.TenXe, FallbackValue='Mazda CX-5'}" 
                                               FontWeight="Bold" FontSize="18" Foreground="#0F172A"/>
                                    <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{Binding XeDuocChon.BienSo, FallbackValue='51F-123.45'}" 
                                                   FontWeight="Bold" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="2025 • Sedan Comfort" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="Automatic" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                        <TextBlock Text="5 chỗ" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="Xăng" FontSize="11" Foreground="#475569"/>
                                    </Border>
                                </StackPanel>

                                <DockPanel LastChildFill="False">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding XeDuocChon.GiaThueNgay, StringFormat='{}{0:N0} đ', FallbackValue='700,000 đ'}" 
                                                   FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text=" / ngày" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CỘT PHẢI -->
                    <StackPanel Grid.Column="2">
                        <!-- KHỐI 03: NGÀY THUÊ -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="03  Ngày thuê" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Ngày nhận" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <DatePicker SelectedDate="{Binding NgayBatDau, Mode=TwoWay}" BorderThickness="0" Background="Transparent"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel>
                                            <TextBlock Text="Ngày trả" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <DatePicker SelectedDate="{Binding NgayKetThuc, Mode=TwoWay}" BorderThickness="0" Background="Transparent"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="#059669" VerticalAlignment="Center"/>
                                                <TextBlock Text=" Thời gian thuê" FontSize="11" Foreground="#047857" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding SoNgayThue}" FontSize="28" FontWeight="Bold" Foreground="#065F46"/>
                                                <TextBlock Text=" ngày" FontSize="14" FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Ngày nhận:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding NgayBatDau, StringFormat='{}{0:dddd, dd/MM/yyyy}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                            <TextBlock Text="Ngày trả:" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Text="{Binding NgayKetThuc, StringFormat='{}{0:dddd, dd/MM/yyyy}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- KHỐI 04: TIỀN ĐẶT CỌC & HÓA ĐƠN -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="04  Tiền đặt cọc" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding TienCoc, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                        </Border>
                                        <Border Background="#DCFCE7" CornerRadius="6" Padding="8,4">
                                            <TextBlock Text="30%" FontWeight="Bold" FontSize="12" Foreground="#15803D"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Hóa đơn" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tiền thuê" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SoNgayThue, StringFormat='{}{0} x 700,000'}" HorizontalAlignment="Center" FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding TongTienThue, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Thuế VAT" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="10%" HorizontalAlignment="Center" FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding ThueVAT, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </Grid>

                                <Border Height="1" Background="#E2E8F0" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Tổng cộng" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding TongCong, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="20" Foreground="#0F172A"/>
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tiền đặt cọc: " FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding TienCoc, StringFormat='{}{0:N0} đ'}" FontSize="11" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="Còn lại: " FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding TienConLai, StringFormat='{}{0:N0} đ'}" FontSize="11" FontWeight="Bold" Foreground="#0284C7"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding ThongBaoLoi}" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ThongBao}" Foreground="#059669" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Lưu bản nháp"
                                            Click="BtnLuuNhap_Click"
                                            Background="White" BorderBrush="#E2E8F0" Foreground="#475569"
                                            Height="44" FontSize="13" FontWeight="SemiBold"
                                            materialDesign:ButtonAssist.CornerRadius="8"/>

                                    <Button Grid.Column="2" Content="📄  Tạo hợp đồng  ➔"
                                            Command="{Binding TaoDonThueCommand}"
                                            Background="#1E3E34" BorderBrush="#1E3E34" Foreground="White"
                                            Height="44" FontSize="14" FontWeight="Bold"
                                            materialDesign:ButtonAssist.CornerRadius="8"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ================= TAB 1: DANH SÁCH HỢP ĐỒNG ĐÃ KÝ ================= -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabDangChon}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Danh sách hợp đồng đang quản lý" FontWeight="Bold" FontSize="16" Foreground="#0F172A"/>
                            <Border Background="#F1F5F9" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DanhSachDonThue.Count, StringFormat='{}{0} đơn'}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding LamMoiCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#059669" VerticalAlignment="Center"/>
                                <TextBlock Text="Làm mới" Margin="4,0,0,0" Foreground="#059669" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!-- BẢNG DỮ LIỆU HỢP ĐỒNG (DataGrid) -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DanhSachDonThue}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" Background="White"
                              BorderThickness="0" HeadersVisibility="Column"
                              RowHeight="50" FontSize="13">
                        <DataGrid.Columns>
                            <!-- Cột Mã đơn -->
                            <DataGridTextColumn Header="MÃ HĐ" Binding="{Binding MaDon, StringFormat='#HD{0:D3}'}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cột Khách hàng -->
                            <DataGridTemplateColumn Header="KHÁCH HÀNG" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KhachHang.HoTen}" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding KhachHang.SDT}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Xe -->
                            <DataGridTemplateColumn Header="PHƯƠNG TIỆN" Width="1.8*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Xe.TenXe}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Xe.BienSo}" FontSize="11" Foreground="#059669" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Thời gian thuê -->
                            <DataGridTemplateColumn Header="THỜI GIAN THUÊ" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NgayThue, StringFormat='Từ: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#475569"/>
                                            <TextBlock Text="{Binding NgayTra, StringFormat='Đến: {0:dd/MM/yyyy}'}" FontSize="12" Foreground="#475569"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Tổng tiền & Cọc -->
                            <DataGridTemplateColumn Header="TỔNG TIỀN / CỌC" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TongTienDuKien, StringFormat='{}{0:N0} đ'}" FontWeight="Bold" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding TienCoc, StringFormat='Cọc: {0:N0} đ'}" FontSize="11" Foreground="#059669"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Trạng thái -->
                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đang thuê">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã hoàn thành">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Đang thuê">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TrangThai}" Value="Đã hoàn thành">
                                                                <Setter Property="Foreground" Value="#64748B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Thao tác Trả xe -->
                            <DataGridTemplateColumn Header="THAO TÁC" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Trả xe"
                                                Command="{Binding DataContext.TraXeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                                Background="#0284C7" BorderBrush="#0284C7" Foreground="White"
                                                Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="6">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TrangThai}" Value="Đã hoàn thành">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>